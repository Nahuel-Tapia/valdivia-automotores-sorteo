# Valdivia Automotores - Configuración de Variables de Entorno

# 1. Base de Datos SQLite Local o Turso Remota
# Si se deja vacío, utiliza la base local SQLite en data/sorteo.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# 2. Mercado Pago Checkout Pro (Access Token de Producción o Sandbox)
# Si se deja vacío, la aplicación funciona en Modo Demo Local para pruebas
MERCADOPAGO_ACCESS_TOKEN=

# 3. Servicio de Emailing Resend
# Si se deja vacío, los correos se registran en consola de forma segura
RESEND_API_KEY=
