---
import "@/styles/global.css"
import Header from "@/components/Header.astro"
import Footer from "@/components/Footer.astro"
import FloatingSupport from "@/components/FloatingSupport.astro"

interface Props {
  title?: string
  description?: string
}

const {
  title = "Valdivia Automotores | Sorteo BYD Dolphin Mini 0km",
  description = "Participá del gran sorteo de un BYD Dolphin Mini 0km 100% eléctrico de Valdivia Automotores. Comprá tus números online con Mercado Pago de forma rápida y segura.",
} = Astro.props
---

<!doctype html>
<html lang="es" class="bg-cloud">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#1f2a52" />
    <meta name="description" content={description} />

    <!-- Open Graph / Meta Etiquetas para Compartir en WhatsApp y Redes -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/cars/dolphin-green.png" />
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content="/cars/dolphin-green.png" />

    <link rel="icon" type="image/png" href="/logo-valdivia.png" />

    <!-- Pre-conectividad de Dominios Externos y Pre-carga de Imagen Principal -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="dns-prefetch" href="https://fonts.googleapis.com" />
    <link rel="dns-prefetch" href="https://fonts.gstatic.com" />
    <link rel="preload" as="image" href="/cars/dolphin-green.png" fetchpriority="high" />

    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Sora:wght@600;700;800&display=swap"
      rel="stylesheet"
    />
    <!-- SDK de Mercado Pago (Carga diferida asíncrona para no bloquear el renderizado inicial) -->
    <script src="https://sdk.mercadopago.com/js/v2" defer is:inline></script>
    <title>{title}</title>
  </head>
  <body class="min-h-screen flex flex-col">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    <FloatingSupport />
  </body>
</html>
