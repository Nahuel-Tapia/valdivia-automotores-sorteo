---
import { raffle } from "@/data/raffle"

const drawDate = new Date(raffle.drawDate).toLocaleDateString("es-AR", {
  day: "2-digit",
  month: "long",
  year: "numeric",
})

const items = [
  `El sorteo se realizará el ${drawDate} en base a ${raffle.drawChannel}.`,
  "Cada número comprado equivale a una chance de ganar el premio.",
  "El ganador será contactado por los datos ingresados en la compra.",
  "El premio se entrega patentado y sin cargos adicionales.",
  "Participan mayores de 18 años residentes en el país.",
  "Este es un sitio de demostración; la compra no genera cargos reales.",
]
---

<section id="bases" class="container-app scroll-mt-20 py-16">
  <div class="card p-8 sm:p-10">
    <span class="text-sm font-semibold uppercase tracking-[0.16em] text-brand">Transparencia</span>
    <h2 class="mt-3 font-display text-3xl font-800 text-navy sm:text-4xl">Bases y condiciones</h2>
    <ul class="mt-6 grid gap-3 sm:grid-cols-2">
      {
        items.map((item) => (
          <li class="flex items-start gap-3 text-sm leading-relaxed text-navy/75">
            <span class="mt-1.5 h-1.5 w-1.5 flex-none rounded-full bg-brand"></span>
            {item}
          </li>
        ))
      }
    </ul>
  </div>
</section>
