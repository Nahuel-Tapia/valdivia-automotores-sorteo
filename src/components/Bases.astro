---
import { raffle, formatCurrency } from "@/data/raffle"
import { getTicketPrice, getDrawDate } from "@/lib/services/settings"

const ticketUnitPrice = await getTicketPrice()
const rawDrawDate = await getDrawDate()
const drawDate = new Date(rawDrawDate).toLocaleDateString("es-AR", {
  day: "2-digit",
  month: "long",
  year: "numeric",
})

const items = [
  `Organizador: Valdivia Automotores. Valor de cada número: ${formatCurrency(ticketUnitPrice)} (pesos argentinos).`,
  "Participación confirmada tras seleccionar número y acreditarse el pago por Mercado Pago.",
  "Sorteo estimado en 1 mes. Se puede adelantar por venta total o extender hasta máximo 2 meses.",
  "Premio: BYD Dolphin Mini GL 0 km. No canjeable por dinero ni otro bien.",
  "Pueden participar menores de 18 años (el vehículo se inscribirá a nombre de padres/tutores).",
  "Gastos de inscripción inicial, patentamiento y transferencia a cargo exclusivo del ganador.",
  "Pueden participar empleados de Valdivia Automotores en igualdad de condiciones.",
]
---

<section id="bases" class="container-app scroll-mt-20 py-16">
  <div class="card p-8 sm:p-10">
    <span class="text-sm font-semibold uppercase tracking-[0.16em] text-brand">Transparencia</span>
    <h2 class="mt-3 font-display text-3xl font-800 text-navy sm:text-4xl">Bases y condiciones</h2>
    <ul class="mt-6 grid gap-3 sm:grid-cols-2">
      {
        items.map((item) => (
          <li class="flex items-start gap-3 text-sm leading-relaxed text-navy/75">
            <span class="mt-1.5 h-1.5 w-1.5 flex-none rounded-full bg-brand"></span>
            {item}
          </li>
        ))
      }
    </ul>
  </div>
</section>
