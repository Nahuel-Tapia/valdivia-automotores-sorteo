---
import { Ticket } from "lucide-astro"
import { Image } from "astro:assets"
import logoValdivia from "@/assets/logo-valdivia.png"
---

<header class="sticky top-0 z-50 border-b border-navy/10 bg-white/90 backdrop-blur">
  <div class="container-app flex h-16 items-center justify-between gap-4">
    <a href="/" class="flex items-center">
      <Image
        src={logoValdivia}
        alt="Valdivia Automotores"
        height={48}
        class="h-10 sm:h-11 w-auto object-contain"
      />
    </a>

    <nav class="hidden items-center gap-8 md:flex" aria-label="Principal">
      <a href="/#premio" class="text-sm font-semibold text-navy/70 transition hover:text-navy">Premios</a>
      <a href="/#showroom" class="text-sm font-semibold text-navy/70 transition hover:text-navy">Showroom 3D</a>
      <a href="/#como-participar" class="text-sm font-semibold text-navy/70 transition hover:text-navy">Cómo participar</a>
      <a href="/mis-boletos" class="text-sm font-semibold text-navy/70 transition hover:text-navy">Mis boletos</a>
      <a href="/#faq" class="text-sm font-semibold text-navy/70 transition hover:text-navy">FAQ</a>
      <a href="/#bases" class="text-sm font-semibold text-navy/70 transition hover:text-navy">Bases</a>
    </nav>

    <a href="/participar" class="btn-primary px-4 py-2 text-sm">
      <Ticket class="h-4 w-4" />
      Participar
    </a>
  </div>
</header>
