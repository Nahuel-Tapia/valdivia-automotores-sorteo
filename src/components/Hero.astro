---
import { raffle, formatCurrency } from "@/data/raffle"
import Countdown from "@/components/Countdown.astro"
import { Ticket, ShieldCheck, Zap } from "lucide-astro"
---

<section class="relative overflow-hidden bg-navy text-white">
  <!-- Decorative lights -->
  <div class="absolute inset-0 -z-10">
    <div class="absolute -left-24 top-10 h-72 w-72 rounded-full bg-brand/30 blur-3xl"></div>
    <div class="absolute right-0 top-1/2 h-96 w-96 rounded-full bg-brand/20 blur-3xl"></div>
    <div class="absolute left-1/2 top-0 h-64 w-64 -translate-x-1/2 rounded-full bg-electric/10 blur-3xl"></div>
  </div>

  <div class="container-app grid items-center gap-10 py-16 lg:grid-cols-2 lg:py-24">
    <div class="animate-fade-up">
      <span
        class="inline-flex items-center gap-2 rounded-full border border-electric/30 bg-electric/10 px-4 py-1.5 text-xs font-semibold uppercase tracking-[0.16em] text-electric"
      >
        <Zap class="h-3.5 w-3.5" />
        100% Eléctrico · {raffle.drawChannel}
      </span>

      <h1 class="mt-6 font-display text-4xl font-800 leading-[1.05] tracking-tight sm:text-5xl lg:text-6xl">
        Ganá un<br />
        <span class="text-gradient-electric">BYD Dolphin Mini</span><br />
        <span class="text-white">0km {raffle.prizeYear}</span>
      </h1>

      <p class="mt-6 max-w-lg text-lg leading-relaxed text-white/70 text-pretty">
        Participá del gran sorteo de {raffle.brand}. Tu próximo auto eléctrico te espera. Comprá tus números online y pagá seguro con Mercado Pago.
      </p>

      <div class="mt-8 flex flex-wrap items-center gap-4">
        <a href="/participar" class="btn-electric">
          <Ticket class="h-5 w-5" />
          Comprar Boletos
        </a>
        <span class="text-sm text-white/60">
          Desde <strong class="font-display text-lg text-white">{formatCurrency(raffle.ticketBasePrice)}</strong> por número
        </span>
      </div>

      <div class="mt-8 flex items-center gap-2 text-sm text-white/50">
        <ShieldCheck class="h-4 w-4 text-electric/70" />
        Pago 100% seguro · Números asignados al instante
      </div>
    </div>

    <div class="animate-fade-up" style="animation-delay: 0.15s">
      <div class="relative rounded-3xl border border-white/10 bg-white/5 p-4 shadow-glow backdrop-blur">
        <img
          src={raffle.heroImage}
          alt={`${raffle.prizeName} ${raffle.prizeYear}, premio del sorteo`}
          width="720"
          height="480"
          class="w-full rounded-2xl object-contain"
          loading="eager"
        />
        <div class="absolute -bottom-5 left-1/2 w-[92%] -translate-x-1/2 rounded-2xl bg-navy-dark/90 p-4 shadow-card backdrop-blur">
          <p class="text-center text-xs font-semibold uppercase tracking-widest text-electric">
            El sorteo termina en
          </p>
          <div class="mt-3">
            <Countdown />
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="h-8 lg:h-4"></div>
</section>
