---
import { raffle, formatCurrency } from "@/data/raffle"
import { getTicketPrice } from "@/lib/services/settings"
import Countdown from "@/components/Countdown.astro"
import { Ticket, ShieldCheck, Zap, Sparkles } from "lucide-astro"

const ticketUnitPrice = await getTicketPrice()
---

<section class="relative overflow-hidden bg-navy text-white">
  <!-- Decorative studio ambient lights -->
  <div class="absolute inset-0 -z-10 overflow-hidden pointer-events-none">
    <div class="absolute -left-24 top-10 h-96 w-96 rounded-full bg-brand/25 blur-[120px]"></div>
    <div class="absolute right-0 top-1/3 h-[500px] w-[500px] rounded-full bg-electric/20 blur-[150px]"></div>
    <div class="absolute left-1/2 top-0 h-80 w-80 -translate-x-1/2 rounded-full bg-electric/15 blur-[100px]"></div>
    <!-- Fine studio grid lines -->
    <div class="absolute inset-0 bg-grid-pattern opacity-30"></div>
  </div>

  <div class="container-app grid items-center gap-10 py-12 lg:grid-cols-2 lg:py-20">
    <!-- Left Column: Copy & CTAs -->
    <div class="animate-fade-up">
      <span
        class="inline-flex items-center gap-2 rounded-full border border-electric/40 bg-electric/10 px-4 py-1.5 text-xs font-semibold uppercase tracking-[0.18em] text-electric backdrop-blur-md shadow-glow-sm"
      >
        <Zap class="h-3.5 w-3.5 animate-pulse" />
        100% Eléctrico · {raffle.drawChannel}
      </span>

      <h1 class="mt-6 font-display text-4xl font-extrabold leading-[1.08] tracking-tight sm:text-5xl lg:text-6xl">
        Ganá un<br />
        <span class="text-gradient-electric drop-shadow-sm">BYD Dolphin Mini</span><br />
        <span class="text-white">0km {raffle.prizeYear}</span>
      </h1>

      <p class="mt-6 max-w-lg text-lg leading-relaxed text-white/80 text-pretty">
        Participá del gran sorteo de <strong class="text-white font-semibold">{raffle.brand}</strong>. Tu próximo auto eléctrico te espera. Comprá tus números online y pagá seguro con Mercado Pago.
      </p>

      <div class="mt-8 flex flex-wrap items-center gap-4">
        <a href="/participar" class="btn-electric transform hover:scale-105 transition-all duration-300">
          <Ticket class="h-5 w-5" />
          Comprar Boletos
        </a>
        <div class="flex flex-col">
          <span class="text-xs text-white/50 uppercase tracking-wider font-medium">Precio por número</span>
          <span class="font-display text-xl font-extrabold text-white">
            {formatCurrency(ticketUnitPrice)}
          </span>
        </div>
      </div>

      <div class="mt-8 flex items-center gap-3 text-sm text-white/60 bg-white/5 border border-white/10 rounded-2xl p-3.5 max-w-md backdrop-blur-sm">
        <ShieldCheck class="h-5 w-5 flex-shrink-0 text-electric" />
        <span>Pago 100% seguro con Mercado Pago · Números congelados e identificados al instante</span>
      </div>
    </div>

    <!-- Right Column: Premium Vehicle Stage & Countdown -->
    <div class="animate-fade-up" style="animation-delay: 0.15s">
      <div class="flex flex-col gap-5">
        <!-- Showroom Stage Container -->
        <div class="relative overflow-hidden rounded-3xl border border-white/20 bg-gradient-to-b from-white/15 via-white/5 to-navy-dark/40 p-6 sm:p-8 shadow-card backdrop-blur-xl group">
          
          <!-- Studio Center Radial Spotlight Glow -->
          <div class="absolute inset-0 -z-10 bg-[radial-gradient(ellipse_at_center,rgba(0,212,255,0.22)_0%,rgba(31,143,214,0.08)_50%,transparent_75%)]"></div>
          
          <!-- Reflective Podium Stage Floor Glow -->
          <div class="absolute bottom-2 left-1/2 -translate-x-1/2 w-[85%] h-12 bg-electric/25 rounded-[100%] blur-2xl pointer-events-none"></div>
          <div class="absolute bottom-6 left-1/2 -translate-x-1/2 w-[70%] h-4 bg-navy-dark/90 rounded-[100%] blur-md pointer-events-none"></div>

          <!-- Floating Badge Top Left -->
          <div class="absolute top-4 left-4 z-20">
            <span class="inline-flex items-center gap-1.5 bg-navy-dark/90 border border-white/15 text-white text-xs px-3 py-1.5 rounded-full font-bold shadow-lg backdrop-blur-md">
              <Sparkles class="w-3.5 h-3.5 text-electric animate-spin" style="animation-duration: 4s;" />
              <span>BYD Dolphin Mini 0km</span>
            </span>
          </div>

          <!-- Floating Badge Top Right -->
          <div class="absolute top-4 right-4 z-20">
            <span class="inline-flex items-center gap-1.5 bg-electric/15 border border-electric/30 text-electric text-xs px-3 py-1.5 rounded-full font-bold shadow-lg backdrop-blur-md">
              <span>🔋 280 km Autonomía</span>
            </span>
          </div>

          <!-- Main Vehicle Image (Clean Transparent PNG) -->
          <div class="relative py-4 flex items-center justify-center">
            <img
              src={raffle.heroImage}
              alt={`${raffle.prizeName} ${raffle.prizeYear}, premio del sorteo`}
              width="1326"
              height="705"
              class="w-full h-auto max-h-[340px] sm:max-h-[420px] object-contain drop-shadow-[0_25px_35px_rgba(0,0,0,0.65)] group-hover:drop-shadow-[0_30px_45px_rgba(0,212,255,0.4)] group-hover:scale-[1.03] transition-all duration-700 ease-out"
              loading="eager"
              fetchpriority="high"
              decoding="async"
            />
          </div>

          <!-- Floating Badge Bottom Left -->
          <div class="absolute bottom-4 left-4 z-20 hidden sm:block">
            <span class="inline-flex items-center gap-1.5 bg-navy-dark/80 border border-white/10 text-white/80 text-[11px] px-3 py-1 rounded-full font-semibold backdrop-blur-md">
              🛡️ Garantía Batería 8 Años
            </span>
          </div>
        </div>

        <!-- Countdown Timer Card -->
        <div class="rounded-2xl border border-white/15 bg-navy-dark/95 p-4 shadow-card backdrop-blur-md">
          <p class="text-center text-xs font-bold uppercase tracking-widest text-electric flex items-center justify-center gap-2">
            <span class="h-2 w-2 rounded-full bg-electric animate-ping"></span>
            El sorteo finaliza en
          </p>
          <div class="mt-3">
            <Countdown />
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="h-6 lg:h-2"></div>
</section>
