---
import { raffle, formatCurrency } from "@/data/raffle"
import Countdown from "@/components/Countdown.astro"
import { Ticket, ShieldCheck } from "lucide-astro"
---

<section class="relative overflow-hidden bg-navy text-white">
  <div class="absolute inset-0 -z-10">
    <div class="absolute -left-24 top-10 h-72 w-72 rounded-full bg-brand/30 blur-3xl"></div>
    <div class="absolute right-0 top-1/2 h-96 w-96 rounded-full bg-brand/20 blur-3xl"></div>
  </div>

  <div class="container-app grid items-center gap-10 py-14 lg:grid-cols-2 lg:py-20">
    <div class="animate-fade-up">
      <span
        class="inline-flex items-center gap-2 rounded-full border border-brand/40 bg-brand/10 px-4 py-1.5 text-xs font-semibold uppercase tracking-[0.16em] text-brand-light"
      >
        <span class="h-2 w-2 animate-pulse rounded-full bg-brand-light"></span>
        Sorteo oficial · {raffle.drawChannel}
      </span>

      <h1 class="mt-5 font-display text-4xl font-800 leading-[1.05] tracking-tight text-balance sm:text-5xl lg:text-6xl">
        Ganá un <span class="text-brand-light">{raffle.prizeName}</span> {raffle.prizeYear}
      </h1>

      <p class="mt-5 max-w-lg text-lg leading-relaxed text-white/80 text-pretty">
        Participá del gran sorteo de {raffle.brand}. Comprá tus números online en minutos y pagá seguro con Mercado Pago.
      </p>

      <div class="mt-8 flex flex-wrap items-center gap-4">
        <a href="/participar" class="btn-primary">
          <Ticket class="h-5 w-5" />
          Comprar números
        </a>
        <span class="text-sm text-white/70">
          Desde <strong class="font-display text-lg text-white">{formatCurrency(raffle.ticketBasePrice)}</strong> por número
        </span>
      </div>

      <div class="mt-8 flex items-center gap-2 text-sm text-white/70">
        <ShieldCheck class="h-4 w-4 text-brand-light" />
        Pago 100% seguro · Números asignados al instante
      </div>
    </div>

    <div class="animate-fade-up">
      <div class="relative rounded-3xl border border-white/10 bg-white/5 p-4 backdrop-blur">
        <img
          src={raffle.heroImage}
          alt={`${raffle.prizeName} ${raffle.prizeYear}, premio del sorteo`}
          width="720"
          height="480"
          class="w-full rounded-2xl object-cover"
        />
        <div class="absolute -bottom-5 left-1/2 w-[92%] -translate-x-1/2 rounded-2xl bg-navy-dark/90 p-4 shadow-card backdrop-blur">
          <p class="text-center text-xs font-semibold uppercase tracking-widest text-brand-light">
            El sorteo termina en
          </p>
          <div class="mt-3">
            <Countdown />
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="h-8 lg:h-4"></div>
</section>
