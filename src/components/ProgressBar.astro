---
import { db, initDB } from "@/lib/db"
import { getTicketCount } from "@/lib/services/settings"

let paidTickets = 0
const totalTickets = await getTicketCount()

try {
  await initDB()
  const res = await db.execute("SELECT COUNT(*) as paidCount FROM tickets WHERE status = 'paid'")
  paidTickets = Number(res.rows[0]?.paidCount || 0)
} catch (error) {
  console.error("Error consultando conteo de boletos vendidos para ProgressBar:", error)
}

const percentage = totalTickets > 0 ? Math.min(100, Math.round((paidTickets / totalTickets) * 100)) : 0
---

<section class="container-app -mt-6 pb-4 pt-16">
  <div class="card p-6 sm:p-8">
    <div class="flex flex-wrap items-end justify-between gap-2">
      <div>
        <h2 class="font-display text-lg font-700 text-navy">Números vendidos</h2>
        <p class="text-sm text-navy/60">No te quedes afuera, quedan pocos disponibles.</p>
      </div>
      <div class="text-right">
        <span class="font-display text-2xl sm:text-3xl font-800 text-brand">{paidTickets} de {totalTickets}</span>
        <span class="block text-xs font-600 text-navy/60 uppercase tracking-wider">{percentage}% Vendido</span>
      </div>
    </div>
    <div class="mt-4 h-3.5 w-full overflow-hidden rounded-full bg-cloud border border-navy/5">
      <div
        class="h-full rounded-full bg-gradient-to-r from-brand to-brand-light transition-all duration-500 shadow-sm"
        style={`width: ${Math.max(percentage, 2)}%`}
      >
      </div>
    </div>
  </div>
</section>
