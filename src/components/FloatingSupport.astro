---
import { MessageCircle } from "lucide-astro"
---

<aside class="fixed bottom-6 right-6 z-50">
  <a
    href="https://wa.me/5491155555555?text=Hola,%20tengo%20una%20consulta%20sobre%20el%20sorteo%20de%20Valdivia%20Automotores"
    target="_blank"
    rel="noopener noreferrer"
    class="group flex items-center gap-3 rounded-full bg-[#25D366] px-4 py-3 text-white shadow-lg transition-all duration-300 hover:scale-105 hover:bg-[#20ba5a] hover:shadow-xl active:scale-95"
    aria-label="Asistencia por WhatsApp"
  >
    <MessageCircle class="h-6 w-6 fill-current" />
    <span class="max-w-0 overflow-hidden whitespace-nowrap font-display text-sm font-700 transition-all duration-300 group-hover:max-w-xs sm:max-w-xs">
      ¿Necesitás ayuda?
    </span>
  </a>
</aside>
