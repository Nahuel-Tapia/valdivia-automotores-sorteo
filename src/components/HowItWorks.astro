---
import { MousePointerClick, CreditCard, Hash, Trophy } from "lucide-astro"

const steps = [
  { icon: MousePointerClick, title: "Elegí tus números", text: "Seleccioná tus números de la suerte en la grilla interactiva." },
  { icon: CreditCard, title: "Pago de forma segura", text: "Aboná con Mercado Pago, tarjeta o transferencia en segundos." },
  { icon: Hash, title: "Recibí tus números", text: "Te asignamos tus números al instante y por email." },
  { icon: Trophy, title: "Esperá el sorteo", text: "El sorteo se realiza por Lotería Nacional. ¡Mucha suerte!" },
]
---

<section id="como-participar" class="scroll-mt-20 bg-white py-16">
  <div class="container-app">
    <div class="mx-auto max-w-2xl text-center">
      <span class="text-sm font-semibold uppercase tracking-[0.16em] text-brand">Simple y rápido</span>
      <h2 class="mt-3 font-display text-3xl font-800 text-navy text-balance sm:text-4xl">
        Cómo participar en 4 pasos
      </h2>
    </div>

    <ol class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        steps.map((step, i) => (
          <li class="relative rounded-2xl border border-navy/10 bg-cloud p-6">
            <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-navy text-white">
              <step.icon class="h-6 w-6" />
            </span>
            <span class="absolute right-5 top-5 font-display text-3xl font-800 text-navy/10">
              {String(i + 1).padStart(2, "0")}
            </span>
            <h3 class="mt-5 font-display text-lg font-700 text-navy">{step.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-navy/70">{step.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
