---
import { raffle } from "@/data/raffle"
import { Zap, Gauge, Battery, ShieldCheck, Bluetooth, Tv, Award, Sparkles, Image as ImageIcon, X, Ticket } from "lucide-astro"

const carIcons = [Zap, Battery, Gauge, ShieldCheck]
const motoIcons = [Zap, Battery, Gauge, Tv, Bluetooth, Award]
---

<section id="premio" class="container-app scroll-mt-20 py-16 space-y-16">
  <!-- Section Title -->
  <div class="text-center max-w-2xl mx-auto space-y-3">
    <span class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full bg-brand/10 text-brand text-xs font-bold uppercase tracking-widest">
      <Sparkles class="w-4 h-4" />
      Grandes Premios del Sorteo
    </span>
    <h2 class="font-display text-3xl font-extrabold text-navy sm:text-4xl">
      2 Premios Increíbles con tu Mismo Boleto
    </h2>
    <p class="text-base text-navy/70 leading-relaxed">
      Cada número adquirido te otorga doble oportunidad de ganar: participás por el auto 0km y por la moto 100% eléctrica.
    </p>
  </div>

  <!-- 1º PREMIO: AUTO BYD DOLPHIN MINI -->
  <div class="card p-6 sm:p-10 border-navy/15 bg-gradient-to-br from-white via-cloud/30 to-white shadow-card">
    <div class="grid items-center gap-10 lg:grid-cols-2">
      <div class="order-2 lg:order-1">
        <span class="inline-flex items-center gap-1.5 rounded-full bg-amber-500/10 px-3.5 py-1 text-xs font-extrabold uppercase tracking-wider text-amber-600">
          🏆 1º PREMIO OFICIAL
        </span>
        <h3 class="mt-3 font-display text-3xl font-800 text-navy text-balance sm:text-4xl">
          Un {raffle.prizeName} 0km
        </h3>
        <p class="mt-4 text-base leading-relaxed text-navy/70 text-pretty">
          100% eléctrico, patentado y con todos los gastos de transferencia incluidos. El auto urbano más tecnológico del mercado.
        </p>

        <dl class="mt-8 grid grid-cols-2 gap-4">
          {
            raffle.prizeSpecs.map((spec, i) => {
              const Icon = carIcons[i % carIcons.length]
              return (
                <div class="card flex items-start gap-3 p-4 bg-white border-navy/10 shadow-sm">
                  <span class="flex h-10 w-10 flex-none items-center justify-center rounded-xl bg-brand/10 text-brand">
                    <Icon class="h-5 w-5" />
                  </span>
                  <div>
                    <dt class="text-xs font-semibold uppercase tracking-wide text-navy/50">{spec.label}</dt>
                    <dd class="mt-0.5 font-display text-sm font-700 text-navy">{spec.value}</dd>
                  </div>
                </div>
              )
            })
          }
        </dl>
      </div>

      <div class="order-1 lg:order-2">
        <div class="relative overflow-hidden rounded-3xl border border-navy/15 bg-gradient-to-b from-navy/10 via-navy/5 to-transparent p-6 sm:p-8 shadow-card backdrop-blur-md flex items-center justify-center group">
          <div class="absolute inset-0 -z-10 bg-[radial-gradient(ellipse_at_center,rgba(31,143,214,0.15)_0%,transparent_75%)]"></div>
          <div class="absolute bottom-4 left-1/2 -translate-x-1/2 w-3/4 h-10 bg-brand/20 rounded-[100%] blur-xl pointer-events-none"></div>
          
          <img
            src={raffle.heroImage}
            alt={`${raffle.prizeName} 0km`}
            width="720"
            height="520"
            class="w-full h-auto max-h-[360px] object-contain drop-shadow-[0_20px_30px_rgba(31,42,82,0.35)] group-hover:scale-[1.03] transition-transform duration-500"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>
    </div>
  </div>

  <!-- 2º PREMIO: MOTO BIKER ELECTRICA -->
  <div id="premio-moto" class="card p-6 sm:p-10 border-electric/30 bg-gradient-to-br from-navy via-navy-dark to-navy text-white shadow-card scroll-mt-24">
    <div class="grid items-center gap-10 lg:grid-cols-2">
      <!-- Left Column: Moto Details -->
      <div>
        <span class="inline-flex items-center gap-1.5 rounded-full bg-electric/15 border border-electric/30 px-3.5 py-1 text-xs font-extrabold uppercase tracking-wider text-electric backdrop-blur-md">
          🛵 2º PREMIO OFICIAL
        </span>
        <h3 class="mt-3 font-display text-3xl font-800 text-white text-balance sm:text-4xl">
          {raffle.secondPrize.name}
        </h3>
        <p class="mt-2 text-sm font-semibold text-electric uppercase tracking-wider">
          {raffle.secondPrize.tagline}
        </p>
        <p class="mt-4 text-base leading-relaxed text-white/80 text-pretty">
          Movilidad urbana silenciosa, ecológica y ágil. Equipada con motor de 499W, batería de alta capacidad, tablero digital LCD, altavoz Bluetooth integrado y 3 modos de velocidad.
        </p>

        <dl class="mt-8 grid grid-cols-2 gap-4">
          {
            raffle.secondPrize.specs.map((spec, i) => {
              const Icon = motoIcons[i % motoIcons.length]
              return (
                <div class="rounded-2xl border border-white/10 bg-white/5 p-4 backdrop-blur-md flex items-start gap-3">
                  <span class="flex h-10 w-10 flex-none items-center justify-center rounded-xl bg-electric/15 text-electric">
                    <Icon class="h-5 w-5" />
                  </span>
                  <div>
                    <dt class="text-[11px] font-semibold uppercase tracking-wide text-white/50">{spec.label}</dt>
                    <dd class="mt-0.5 font-display text-sm font-700 text-white">{spec.value}</dd>
                  </div>
                </div>
              )
            })
          }
        </dl>

        <div class="mt-8">
          <button
            type="button"
            id="btn-open-moto-modal-inline"
            class="btn-electric transform hover:scale-105 transition-all duration-300 text-sm"
          >
            <Sparkles class="h-4 w-4" />
            Ver Ficha Técnica Completa
          </button>
        </div>
      </div>

      <!-- Right Column: Interactive Image Gallery -->
      <div class="space-y-4">
        <div class="relative overflow-hidden rounded-3xl border border-white/15 bg-white/5 p-6 sm:p-8 backdrop-blur-xl shadow-glow-sm flex items-center justify-center group min-h-[340px]">
          <div class="absolute inset-0 -z-10 bg-[radial-gradient(ellipse_at_center,rgba(0,212,255,0.2)_0%,transparent_75%)]"></div>
          <div class="absolute bottom-4 left-1/2 -translate-x-1/2 w-3/4 h-8 bg-electric/20 rounded-[100%] blur-xl pointer-events-none"></div>

          <!-- Main Image -->
          <img
            id="moto-main-img"
            src={raffle.secondPrize.image}
            alt={raffle.secondPrize.name}
            class="w-full h-auto max-h-[340px] object-contain drop-shadow-[0_20px_35px_rgba(0,0,0,0.6)] group-hover:scale-[1.03] transition-all duration-500 cursor-pointer"
          />
        </div>

        <!-- Thumbnails Selector Bar -->
        <div class="flex flex-wrap items-center justify-center gap-3">
          <button
            type="button"
            data-target-src={raffle.secondPrize.image}
            class="moto-thumb-btn active flex items-center gap-2 rounded-xl border border-electric bg-electric/20 px-3.5 py-2 text-xs font-bold text-white transition hover:bg-electric/30"
          >
            <ImageIcon class="h-4 w-4 text-electric" />
            <span>Estudio</span>
          </button>

          <button
            type="button"
            data-target-src={raffle.secondPrize.riderImage}
            class="moto-thumb-btn flex items-center gap-2 rounded-xl border border-white/10 bg-white/5 px-3.5 py-2 text-xs font-bold text-white/70 transition hover:border-white/30 hover:text-white"
          >
            <ImageIcon class="h-4 w-4 text-electric" />
            <span>Urbana</span>
          </button>

          <button
            type="button"
            data-target-src={raffle.secondPrize.specsImage}
            class="moto-thumb-btn flex items-center gap-2 rounded-xl border border-white/10 bg-white/5 px-3.5 py-2 text-xs font-bold text-white/70 transition hover:border-white/30 hover:text-white"
          >
            <ImageIcon class="h-4 w-4 text-electric" />
            <span>Ficha Técnica Gráfica</span>
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- MODAL POPUP: DETALLES COMPLETOS BIKER MOTO -->
<div
  id="moto-details-modal"
  class="fixed inset-0 z-50 hidden items-center justify-center bg-navy/80 backdrop-blur-md p-4 overflow-y-auto"
>
  <div class="relative w-full max-w-4xl rounded-3xl border border-white/20 bg-navy-dark p-6 sm:p-8 shadow-2xl text-white my-8 space-y-6">
    <!-- Header -->
    <div class="flex items-center justify-between border-b border-white/10 pb-4">
      <div class="flex items-center gap-3">
        <span class="flex h-10 w-10 items-center justify-center rounded-2xl bg-electric/20 text-electric border border-electric/30">
          🛵
        </span>
        <div>
          <span class="text-xs font-extrabold uppercase tracking-widest text-electric">2º Premio Oficial</span>
          <h3 class="font-display text-xl font-extrabold sm:text-2xl">{raffle.secondPrize.name}</h3>
        </div>
      </div>
      <button
        type="button"
        id="moto-modal-close-btn"
        class="rounded-xl bg-white/10 p-2 text-white/70 hover:bg-white/20 hover:text-white transition"
      >
        <X class="h-6 w-6" />
      </button>
    </div>

    <!-- Body Grid -->
    <div class="grid gap-8 lg:grid-cols-2 items-center">
      <!-- Modal Left: Interactive Preview Image -->
      <div class="space-y-4">
        <div class="relative overflow-hidden rounded-2xl border border-white/10 bg-white/5 p-4 flex items-center justify-center min-h-[300px]">
          <img
            id="modal-moto-img"
            src={raffle.secondPrize.image}
            alt="Detalle Biker Moto"
            class="w-full h-auto max-h-[380px] object-contain drop-shadow-xl"
          />
        </div>
        <!-- Modal Thumbnails -->
        <div class="flex flex-wrap items-center justify-center gap-2">
          <button
            type="button"
            data-src={raffle.secondPrize.image}
            class="modal-thumb-btn active rounded-lg border border-electric bg-electric/20 px-3 py-1.5 text-xs font-bold text-white"
          >
            Estudio
          </button>
          <button
            type="button"
            data-src={raffle.secondPrize.riderImage}
            class="modal-thumb-btn rounded-lg border border-white/10 bg-white/5 px-3 py-1.5 text-xs font-bold text-white/70 hover:text-white"
          >
            Urbana
          </button>
          <button
            type="button"
            data-src={raffle.secondPrize.specsImage}
            class="modal-thumb-btn rounded-lg border border-white/10 bg-white/5 px-3 py-1.5 text-xs font-bold text-white/70 hover:text-white"
          >
            Ficha Técnica Gráfica
          </button>
        </div>
      </div>

      <!-- Modal Right: Specs List -->
      <div class="space-y-6">
        <div>
          <h4 class="font-display text-lg font-bold text-white">Especificaciones Técnicas completas</h4>
          <p class="text-xs text-white/70 mt-1 leading-relaxed">
            Moto 100% eléctrica diseñada para el uso diario urbano con máximo confort, ahorro y conectividad.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-sm">
          <div class="rounded-xl bg-white/5 border border-white/10 p-3">
            <span class="text-xs text-electric font-semibold block uppercase">Potencia Motor</span>
            <strong class="text-base text-white">499 W</strong>
          </div>
          <div class="rounded-xl bg-white/5 border border-white/10 p-3">
            <span class="text-xs text-electric font-semibold block uppercase">Batería</span>
            <strong class="text-base text-white">48V 20Ah Plomo-Ácido</strong>
          </div>
          <div class="rounded-xl bg-white/5 border border-white/10 p-3">
            <span class="text-xs text-electric font-semibold block uppercase">Velocidad Máxima</span>
            <strong class="text-base text-white">29 km/h (3 vel.)</strong>
          </div>
          <div class="rounded-xl bg-white/5 border border-white/10 p-3">
            <span class="text-xs text-electric font-semibold block uppercase">Tablero</span>
            <strong class="text-base text-white">Instrumento LCD Digital</strong>
          </div>
          <div class="rounded-xl bg-white/5 border border-white/10 p-3">
            <span class="text-xs text-electric font-semibold block uppercase">Sonido</span>
            <strong class="text-base text-white">Altavoz Bluetooth</strong>
          </div>
          <div class="rounded-xl bg-white/5 border border-white/10 p-3">
            <span class="text-xs text-electric font-semibold block uppercase">Controlador</span>
            <strong class="text-base text-white">6 + Tubos</strong>
          </div>
        </div>

        <div class="rounded-xl bg-electric/10 border border-electric/30 p-3.5 text-xs text-white/80 leading-relaxed">
          💡 <strong>Equipamiento completo:</strong> Faro delantero de alta potencia LED, luces traseras, canasto frontal reforzado, asiento trasero con respaldo acolchado y pedales de auxilio.
        </div>

        <div class="flex items-center justify-end gap-3 pt-2">
          <button
            type="button"
            id="modal-moto-close-bottom"
            class="btn-secondary text-xs py-2.5 px-4 bg-white/10 border-white/20 text-white hover:bg-white/20"
          >
            Cerrar
          </button>
          <a
            href="/participar"
            class="btn-electric text-xs py-2.5 px-5"
          >
            <Ticket class="h-4 w-4" />
            Comprar Boletos
          </a>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function initMotoGalleryAndModal() {
    const mainImg = document.getElementById("moto-main-img") as HTMLImageElement | null
    const thumbBtns = document.querySelectorAll<HTMLButtonElement>(".moto-thumb-btn")
    const modal = document.getElementById("moto-details-modal")
    const modalCloseBtn = document.getElementById("moto-modal-close-btn")
    const modalCloseBottom = document.getElementById("modal-moto-close-bottom")
    const modalImg = document.getElementById("modal-moto-img") as HTMLImageElement | null
    const modalThumbs = document.querySelectorAll<HTMLButtonElement>(".modal-thumb-btn")
    const inlineOpenBtn = document.getElementById("btn-open-moto-modal-inline")

    // Inline Thumbnails
    thumbBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        const src = btn.getAttribute("data-target-src")
        if (mainImg && src) {
          mainImg.style.opacity = "0"
          setTimeout(() => {
            mainImg.src = src
            mainImg.style.opacity = "1"
          }, 150)

          thumbBtns.forEach((b) => {
            b.classList.remove("border-electric", "bg-electric/20", "text-white")
            b.classList.add("border-white/10", "bg-white/5", "text-white/70")
          })
          btn.classList.remove("border-white/10", "bg-white/5", "text-white/70")
          btn.classList.add("border-electric", "bg-electric/20", "text-white")
        }
      })
    })

    // Open Modal
    const openModal = () => {
      if (modal) {
        modal.classList.remove("hidden")
        modal.classList.add("flex")
      }
    }

    const closeModal = () => {
      if (modal) {
        modal.classList.add("hidden")
        modal.classList.remove("flex")
      }
    }

    inlineOpenBtn?.addEventListener("click", openModal)
    mainImg?.addEventListener("click", openModal)
    modalCloseBtn?.addEventListener("click", closeModal)
    modalCloseBottom?.addEventListener("click", closeModal)

    modal?.addEventListener("click", (e) => {
      if (e.target === modal) closeModal()
    })

    // Global listener for hero button
    const heroBtn = document.getElementById("btn-hero-view-moto")
    heroBtn?.addEventListener("click", (e) => {
      e.preventDefault()
      openModal()
      const target = document.getElementById("premio-moto")
      if (target) {
        target.scrollIntoView({ behavior: "smooth", block: "start" })
      }
    })

    // Modal Thumbnails
    modalThumbs.forEach((btn) => {
      btn.addEventListener("click", () => {
        const src = btn.getAttribute("data-src")
        if (modalImg && src) {
          modalImg.src = src
          modalThumbs.forEach((b) => {
            b.classList.remove("border-electric", "bg-electric/20", "text-white")
            b.classList.add("border-white/10", "bg-white/5", "text-white/70")
          })
          btn.classList.remove("border-white/10", "bg-white/5", "text-white/70")
          btn.classList.add("border-electric", "bg-electric/20", "text-white")
        }
      })
    })
  }

  initMotoGalleryAndModal()
  document.addEventListener("astro:after-swap", initMotoGalleryAndModal)
</script>
