---
import { raffle } from "@/data/raffle"
import { Zap, Gauge, Battery, ShieldCheck } from "lucide-astro"

const icons = [Zap, Battery, Gauge, ShieldCheck]
---

<section id="premio" class="container-app scroll-mt-20 py-14">
  <div class="grid items-center gap-10 lg:grid-cols-2">
    <div class="order-2 lg:order-1">
      <span class="text-sm font-semibold uppercase tracking-[0.16em] text-brand">El premio</span>
      <h2 class="mt-3 font-display text-3xl font-800 text-navy text-balance sm:text-4xl">
        Un {raffle.prizeName} 0km, listo para vos
      </h2>
      <p class="mt-4 max-w-lg text-base leading-relaxed text-navy/70 text-pretty">
        100% eléctrico, patentado y con todos los gastos incluidos. Solo tenés que elegir tus números de la suerte y esperar el sorteo.
      </p>

      <dl class="mt-8 grid grid-cols-2 gap-4">
        {
          raffle.prizeSpecs.map((spec, i) => {
            const Icon = icons[i % icons.length]
            return (
              <div class="card flex items-start gap-3 p-4">
                <span class="flex h-10 w-10 flex-none items-center justify-center rounded-xl bg-brand/10 text-brand">
                  <Icon class="h-5 w-5" />
                </span>
                <div>
                  <dt class="text-xs font-semibold uppercase tracking-wide text-navy/50">{spec.label}</dt>
                  <dd class="mt-0.5 font-display text-sm font-700 text-navy">{spec.value}</dd>
                </div>
              </div>
            )
          })
        }
      </dl>
    </div>

    <div class="order-1 lg:order-2">
      <img
        src="/cars/dolphin-blue.png"
        alt={`${raffle.prizeName} vista lateral`}
        width="720"
        height="520"
        class="w-full rounded-3xl border border-navy/10 object-contain shadow-card"
        loading="lazy"
        decoding="async"
      />
    </div>
  </div>
</section>
