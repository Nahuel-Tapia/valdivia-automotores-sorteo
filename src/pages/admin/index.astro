---
import Layout from "@/layouts/Layout.astro"
import { ShieldCheck, DollarSign, Ticket, Lock, LogOut, Download, Search, CheckCircle, Mail, Eye, X, Send, RotateCcw } from "lucide-astro"
---

<Layout title="Panel de Administración | Valdivia Automotores">
  <section class="bg-navy py-8 text-white">
    <div class="container-app flex items-center justify-between">
      <div>
        <span class="text-xs font-semibold uppercase tracking-widest text-brand-light">Dashboard Privado</span>
        <h1 class="mt-1 font-display text-2xl font-800 sm:text-3xl">Administración de Sorteo</h1>
      </div>
      <div class="flex items-center gap-3">
        <button id="btn-reset-db" class="hidden btn-secondary text-xs py-2 px-3 bg-red-600/90 border-red-500 text-white hover:bg-red-700">
          <RotateCcw class="h-4 w-4" />
          Resetear DB
        </button>
        <button id="btn-export-csv" class="hidden btn-primary text-xs py-2 px-3 bg-brand text-white">
          <Download class="h-4 w-4" />
          Exportar CSV
        </button>
        <button id="btn-logout" class="hidden btn-secondary text-xs py-2 px-3 bg-white/10 border-white/20 text-white hover:bg-white/20">
          <LogOut class="h-4 w-4" />
          Cerrar Sesión
        </button>
      </div>
    </div>
  </section>

  <!-- Login Form -->
  <div id="login-section" class="container-app py-16">
    <div class="mx-auto max-w-md card p-8">
      <div class="flex items-center gap-3 border-b border-navy/10 pb-4">
        <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-brand/10 text-brand">
          <Lock class="h-5 w-5" />
        </span>
        <div>
          <h2 class="font-display text-lg font-700 text-navy">Acceso Administrador</h2>
          <p class="text-xs text-navy/60">Ingresá tus credenciales oficiales</p>
        </div>
      </div>

      <form id="admin-login-form" class="mt-6 space-y-4">
        <label class="block">
          <span class="text-xs font-700 text-navy/70 uppercase">Email</span>
          <input
            required
            type="email"
            id="admin-email"
            class="mt-1 h-11 w-full rounded-xl border border-navy/15 px-3 text-sm text-navy focus:border-brand focus:outline-none"
            placeholder="admin@valdivia.com"
          />
        </label>
        <label class="block">
          <span class="text-xs font-700 text-navy/70 uppercase">Contraseña</span>
          <input
            required
            type="password"
            id="admin-password"
            class="mt-1 h-11 w-full rounded-xl border border-navy/15 px-3 text-sm text-navy focus:border-brand focus:outline-none"
            placeholder="••••••••"
          />
        </label>
        <button type="submit" id="btn-login" class="btn-primary mt-2 w-full">
          Ingresar al Panel
        </button>
      </form>
    </div>
  </div>

  <!-- Dashboard Content -->
  <div id="dashboard-section" class="container-app hidden py-12 space-y-8">
    <!-- Tarjetas de Métricas -->
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      <div class="card p-5">
        <div class="flex items-center justify-between">
          <span class="text-xs font-700 uppercase tracking-wider text-navy/50">Recaudación Total</span>
          <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-brand/10 text-brand">
            <DollarSign class="h-5 w-5" />
          </span>
        </div>
        <p class="mt-3 font-display text-2xl font-800 text-navy" id="m-revenue">$0</p>
        <p class="mt-1 text-xs text-navy/60"><span id="m-approved-orders">0</span> órdenes aprobadas</p>
      </div>

      <div class="card p-5">
        <div class="flex items-center justify-between">
          <span class="text-xs font-700 uppercase tracking-wider text-navy/50">Boletos Vendidos</span>
          <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-green-500/10 text-green-600">
            <Ticket class="h-5 w-5" />
          </span>
        </div>
        <p class="mt-3 font-display text-2xl font-800 text-navy" id="m-paid">0</p>
        <p class="mt-1 text-xs text-navy/60">Confirmados en DB</p>
      </div>

      <div class="card p-5">
        <div class="flex items-center justify-between">
          <span class="text-xs font-700 uppercase tracking-wider text-navy/50">Boletos Reservados</span>
          <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-amber-500/10 text-amber-600">
            <Ticket class="h-5 w-5" />
          </span>
        </div>
        <p class="mt-3 font-display text-2xl font-800 text-navy" id="m-reserved">0</p>
        <p class="mt-1 text-xs text-navy/60">Tiempo en ventana de 15m</p>
      </div>

      <div class="card p-5">
        <div class="flex items-center justify-between">
          <span class="text-xs font-700 uppercase tracking-wider text-navy/50">Boletos Disponibles</span>
          <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-blue-500/10 text-blue-600">
            <Ticket class="h-5 w-5" />
          </span>
        </div>
        <p class="mt-3 font-display text-2xl font-800 text-navy" id="m-available">200</p>
        <p class="mt-1 text-xs text-navy/60">De 200 totales</p>
      </div>
    </div>

    <!-- Tabla de Últimas Órdenes y Buscador -->
    <div class="card p-6">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between mb-4">
        <div>
          <h2 class="font-display text-lg font-700 text-navy">Gestión de Órdenes y Participantes</h2>
          <p class="text-xs text-navy/60">Tocá cualquier orden para ver los números asignados o re-enviar comprobantes</p>
        </div>
        <div class="relative w-full sm:w-64">
          <Search class="absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-navy/40" />
          <input
            type="text"
            id="search-orders"
            placeholder="Buscar por DNI, Nombre o ID..."
            class="h-9 w-full rounded-xl border border-navy/15 pl-9 pr-3 text-xs text-navy focus:border-brand focus:outline-none"
          />
        </div>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm">
          <thead class="border-b border-navy/10 text-xs font-700 uppercase text-navy/50">
            <tr>
              <th class="pb-3">ID Orden</th>
              <th class="pb-3">Comprador</th>
              <th class="pb-3">Email</th>
              <th class="pb-3">Boletos</th>
              <th class="pb-3">Monto</th>
              <th class="pb-3">Estado</th>
              <th class="pb-3 text-right">Acciones</th>
            </tr>
          </thead>
          <tbody id="orders-table-body" class="divide-y divide-navy/5 font-500">
            <tr>
              <td colspan="7" class="py-4 text-center text-navy/50">Cargando órdenes...</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Modal de Detalle Completo de Orden -->
  <div id="order-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-navy/60 backdrop-blur-sm p-4">
    <div class="relative w-full max-w-xl rounded-2xl bg-white p-6 shadow-2xl space-y-6">
      <div class="flex items-center justify-between border-b border-navy/10 pb-4">
        <div>
          <span class="text-xs font-700 uppercase text-brand">Ficha del Participante</span>
          <h3 id="modal-order-id" class="font-display text-xl font-800 text-navy">Orden #ORD-000000</h3>
        </div>
        <button type="button" id="modal-close-btn" class="rounded-lg p-1.5 text-navy/40 hover:bg-cloud hover:text-navy">
          <X class="h-5 w-5" />
        </button>
      </div>

      <!-- Datos del Comprador -->
      <div class="grid grid-cols-2 gap-4 text-xs">
        <div class="rounded-xl bg-cloud/60 p-3">
          <span class="text-navy/50 font-600 block">Nombre del Comprador</span>
          <strong id="modal-buyer-name" class="text-sm font-700 text-navy">--</strong>
        </div>
        <div class="rounded-xl bg-cloud/60 p-3">
          <span class="text-navy/50 font-600 block">DNI / Documento</span>
          <strong id="modal-buyer-dni" class="text-sm font-700 text-navy">--</strong>
        </div>
        <div class="rounded-xl bg-cloud/60 p-3">
          <span class="text-navy/50 font-600 block">Correo Electrónico</span>
          <strong id="modal-buyer-email" class="text-sm font-700 text-navy">--</strong>
        </div>
        <div class="rounded-xl bg-cloud/60 p-3">
          <span class="text-navy/50 font-600 block">Teléfono / WhatsApp</span>
          <strong id="modal-buyer-phone" class="text-sm font-700 text-navy">--</strong>
        </div>
      </div>

      <!-- Estado y Pago -->
      <div class="flex items-center justify-between border-t border-b border-navy/10 py-3 text-xs">
        <div>
          <span class="text-navy/50 font-600">Medio de Pago:</span>
          <strong id="modal-payment-method" class="ml-1 uppercase text-navy font-700">--</strong>
        </div>
        <div>
          <span class="text-navy/50 font-600">Monto Total:</span>
          <strong id="modal-total-amount" class="ml-1 text-sm font-800 text-brand">--</strong>
        </div>
        <div id="modal-status-badge">
          <!-- Badge dinámico -->
        </div>
      </div>

      <!-- Grilla de Números de la Suerte Asignados -->
      <div>
        <h4 class="font-display text-xs font-700 uppercase tracking-wider text-navy/60 mb-2">Boletos de la Suerte Asignados</h4>
        <div id="modal-tickets-grid" class="flex flex-wrap gap-2 max-h-40 overflow-y-auto p-2 rounded-xl bg-cloud/50 border border-navy/10">
          <span class="text-xs text-navy/40">Cargando boletos...</span>
        </div>
      </div>

      <!-- Acciones de Gestión -->
      <div class="flex flex-wrap items-center justify-between gap-3 pt-2">
        <button
          type="button"
          id="modal-resend-email-btn"
          class="btn-secondary text-xs py-2.5 px-4 bg-brand/10 border-brand/20 text-brand hover:bg-brand hover:text-white transition font-700"
        >
          <Send class="h-4 w-4 inline mr-1" />
          Re-enviar Comprobante por Email
        </button>

        <div id="modal-action-approve-container">
          <!-- Botón aprobar si está pending -->
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  import { formatARS } from "@/lib/cart"

  function initAdmin() {
    const loginSec = document.getElementById("login-section")
    const dashSec = document.getElementById("dashboard-section")
    const form = document.getElementById("admin-login-form") as HTMLFormElement | null
    const logoutBtn = document.getElementById("btn-logout")
    const exportBtn = document.getElementById("btn-export-csv")
    const searchInput = document.getElementById("search-orders") as HTMLInputElement | null

    // Elementos del Modal
    const orderModal = document.getElementById("order-modal")
    const modalCloseBtn = document.getElementById("modal-close-btn")
    const resendEmailBtn = document.getElementById("modal-resend-email-btn")
    let currentSelectedOrderId: string | null = null

    let allOrders: any[] = []

    const token = localStorage.getItem("valdivia_admin_token")
    if (token) {
      showDashboard()
    }

    form?.addEventListener("submit", async (e) => {
      e.preventDefault()
      const email = (document.getElementById("admin-email") as HTMLInputElement).value
      const password = (document.getElementById("admin-password") as HTMLInputElement).value

      try {
        const res = await fetch("/api/admin/login", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ email, password }),
        })
        const data = await res.json()
        if (data.success && data.token) {
          localStorage.setItem("valdivia_admin_token", data.token)
          showDashboard()
        } else {
          alert(data.error || "Credenciales incorrectas")
        }
      } catch (err) {
        alert("Error de conexión al autenticar")
      }
    })

    logoutBtn?.addEventListener("click", () => {
      localStorage.removeItem("valdivia_admin_token")
      location.reload()
    })

    exportBtn?.addEventListener("click", async () => {
      const currentToken = localStorage.getItem("valdivia_admin_token")
      try {
        const res = await fetch("/api/admin/export", {
          headers: { Authorization: `Bearer ${currentToken}` },
        })
        if (res.status === 401) {
          alert("Sesión expirada. Por favor volvaz a ingresar.")
          localStorage.removeItem("valdivia_admin_token")
          location.reload()
          return
        }
        const blob = await res.blob()
        const url = window.URL.createObjectURL(blob)
        const a = document.createElement("a")
        a.href = url
        a.download = `lista_oficial_participantes_${Date.now()}.csv`
        document.body.appendChild(a)
        a.click()
        a.remove()
        window.URL.revokeObjectURL(url)
      } catch {
        alert("Error de conexión al exportar CSV.")
      }
    })

    searchInput?.addEventListener("input", (e) => {
      const q = (e.target as HTMLInputElement).value.trim().toLowerCase()
      renderOrdersTable(allOrders.filter(o => 
        o.id.toLowerCase().includes(q) || 
        o.buyerName.toLowerCase().includes(q) || 
        o.buyerEmail.toLowerCase().includes(q)
      ))
    })

    modalCloseBtn?.addEventListener("click", () => {
      orderModal?.classList.add("hidden")
      orderModal?.classList.remove("flex")
    })

    resendEmailBtn?.addEventListener("click", async () => {
      if (!currentSelectedOrderId) return
      const currentToken = localStorage.getItem("valdivia_admin_token")
      resendEmailBtn.setAttribute("disabled", "true")
      resendEmailBtn.textContent = "Enviando correo..."

      try {
        const res = await fetch("/api/admin/resend-email", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            Authorization: `Bearer ${currentToken}`,
          },
          body: JSON.stringify({ orderId: currentSelectedOrderId }),
        })
        const data = await res.json()
        if (data.success) {
          alert(`✅ ${data.message}`)
        } else {
          alert(`❌ ${data.error || "No se pudo enviar el correo"}`)
        }
      } catch {
        alert("Error de conexión al re-enviar correo.")
      } finally {
        resendEmailBtn.removeAttribute("disabled")
        resendEmailBtn.innerHTML = `<svg class="h-4 w-4 inline mr-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg> Re-enviar Comprobante por Email`
      }
    })

    const resetDbBtn = document.getElementById("btn-reset-db")

    resetDbBtn?.addEventListener("click", async () => {
      if (!confirm("⚠️ ¿Estás seguro de que deseas resetear por completo la base de datos?\n\nSe borrarán todas las órdenes y se restablecerán los 200 boletos a estado disponible.")) {
        return
      }

      const currentToken = localStorage.getItem("valdivia_admin_token")
      try {
        const res = await fetch("/api/admin/reset-db", {
          method: "POST",
          headers: { Authorization: `Bearer ${currentToken}` },
        })
        const data = await res.json()
        if (data.success) {
          alert(`✨ ${data.message}`)
          showDashboard()
        } else {
          alert(`❌ ${data.error || "No se pudo resetear la base de datos."}`)
        }
      } catch {
        alert("Error de conexión al intentar resetear la base de datos.")
      }
    })

    async function showDashboard() {
      const currentToken = localStorage.getItem("valdivia_admin_token")
      if (!currentToken) {
        loginSec?.classList.remove("hidden")
        dashSec?.classList.add("hidden")
        return
      }

      loginSec?.classList.add("hidden")
      dashSec?.classList.remove("hidden")
      logoutBtn?.classList.remove("hidden")
      exportBtn?.classList.remove("hidden")
      resetDbBtn?.classList.remove("hidden")

      try {
        const res = await fetch("/api/admin/metrics", {
          headers: { Authorization: `Bearer ${currentToken}` },
        })
        if (res.status === 401) {
          localStorage.removeItem("valdivia_admin_token")
          location.reload()
          return
        }
        const data = await res.json()
        if (data.success) {
          const m = data.metrics
          document.getElementById("m-revenue")!.textContent = formatARS(m.totalRevenue)
          document.getElementById("m-approved-orders")!.textContent = String(m.approvedOrders)
          document.getElementById("m-paid")!.textContent = String(m.paidTickets)
          document.getElementById("m-reserved")!.textContent = String(m.reservedTickets)
          document.getElementById("m-available")!.textContent = String(m.availableTickets)

          allOrders = data.recentOrders || []
          renderOrdersTable(allOrders)
        }
      } catch (err) {
        console.error("Error al cargar métricas de admin:", err)
      }
    }

    function renderOrdersTable(orders: any[]) {
      const tbody = document.getElementById("orders-table-body")
      if (!tbody) return

      if (orders.length === 0) {
        tbody.innerHTML = `<tr><td colspan="7" class="py-4 text-center text-navy/50">No hay órdenes registradas aún.</td></tr>`
        return
      }

      tbody.innerHTML = orders
        .map(
          (o: any) => `
        <tr class="hover:bg-cloud/70 cursor-pointer group transition">
          <td class="py-3 font-700 text-brand btn-view-detail" data-order="${o.id}">${o.id}</td>
          <td class="py-3 font-600 text-navy btn-view-detail" data-order="${o.id}">${o.buyerName}</td>
          <td class="py-3 text-navy/70 btn-view-detail" data-order="${o.id}">${o.buyerEmail}</td>
          <td class="py-3 font-700 text-navy btn-view-detail" data-order="${o.id}">${o.ticketCount}</td>
          <td class="py-3 font-700 text-navy btn-view-detail" data-order="${o.id}">${formatARS(o.totalAmount)}</td>
          <td class="py-3 btn-view-detail" data-order="${o.id}">
            <span class="rounded-full px-2.5 py-1 text-xs font-800 ${
              o.status === "approved"
                ? "bg-green-100 text-green-700"
                : o.status === "pending"
                ? "bg-amber-100 text-amber-700"
                : "bg-red-100 text-red-700"
            }">
              ${o.status.toUpperCase()}
            </span>
          </td>
          <td class="py-3 text-right">
            <button data-order="${o.id}" class="btn-view-detail rounded-lg bg-navy/10 px-2.5 py-1 text-xs font-700 text-navy hover:bg-navy hover:text-white transition">
              Ver Detalle
            </button>
          </td>
        </tr>
      `
        )
        .join("")

      // Handlers de Detalle
      tbody.querySelectorAll(".btn-view-detail").forEach((el) => {
        el.addEventListener("click", () => {
          const orderId = (el as HTMLElement).dataset.order
          if (orderId) openOrderDetailModal(orderId)
        })
      })
    }

    async function openOrderDetailModal(orderId: string) {
      const currentToken = localStorage.getItem("valdivia_admin_token")
      currentSelectedOrderId = orderId
      orderModal?.classList.remove("hidden")
      orderModal?.classList.add("flex")

      document.getElementById("modal-order-id")!.textContent = `Orden #${orderId}`
      document.getElementById("modal-tickets-grid")!.innerHTML = `<span class="text-xs text-navy/40">Cargando boletos...</span>`

      try {
        const res = await fetch(`/api/admin/order-details?orderId=${orderId}`, {
          headers: { Authorization: `Bearer ${currentToken}` },
        })
        const data = await res.json()

        if (!data.success) {
          alert(data.error || "No se pudo consultar el detalle de la orden.")
          return
        }

        const o = data.order
        document.getElementById("modal-buyer-name")!.textContent = o.buyerName
        document.getElementById("modal-buyer-dni")!.textContent = o.buyerDni
        document.getElementById("modal-buyer-email")!.textContent = o.buyerEmail
        document.getElementById("modal-buyer-phone")!.textContent = o.buyerPhone
        document.getElementById("modal-payment-method")!.textContent = o.paymentMethod
        document.getElementById("modal-total-amount")!.textContent = formatARS(o.totalAmount)

        const badgeContainer = document.getElementById("modal-status-badge")!
        badgeContainer.innerHTML = `
          <span class="rounded-full px-3 py-1 text-xs font-800 ${
            o.status === "approved"
              ? "bg-green-100 text-green-700"
              : o.status === "pending"
              ? "bg-amber-100 text-amber-700"
              : "bg-red-100 text-red-700"
          }">
            ${o.status.toUpperCase()}
          </span>
        `

        // Grid de boletos
        const ticketsGrid = document.getElementById("modal-tickets-grid")!
        if (data.tickets.length === 0) {
          ticketsGrid.innerHTML = `<span class="text-xs text-navy/40">Sin boletos asignados</span>`
        } else {
          ticketsGrid.innerHTML = data.tickets
            .map(
              (t: any) => `
            <span class="rounded-lg bg-navy text-gold px-2.5 py-1 font-display text-xs font-800 shadow-sm border border-navy/20">
              #${t.number}
            </span>
          `
            )
            .join("")
        }

      } catch (err) {
        console.error("Error abriendo modal:", err)
      }
    }
  }

  initAdmin()
  document.addEventListener("astro:page-load", initAdmin)
</script>
