---
import Layout from "@/layouts/Layout.astro"
import { raffle } from "@/data/raffle"
import { CheckCircle2, Mail, Home, Ticket } from "lucide-astro"
import { Image } from "astro:assets"
import logoValdivia from "@/assets/logo-valdivia.png"
import { getMercadoPagoPaymentStatus, processMercadoPagoPaymentStatus, getAccessToken } from "@/lib/services/mercadopago"
import { approveOrderAndTickets } from "@/lib/services/tickets"

export const prerender = false

const drawDate = new Date(raffle.drawDate).toLocaleDateString("es-AR", {
  day: "2-digit",
  month: "long",
  year: "numeric",
})

// Auto-aprobación y actualización atómica en DB al retornar desde Mercado Pago
const paymentId = Astro.url.searchParams.get("payment_id") || Astro.url.searchParams.get("collection_id")
const status = Astro.url.searchParams.get("status") || Astro.url.searchParams.get("collection_status")
const orderId = Astro.url.searchParams.get("external_reference") || Astro.url.searchParams.get("orderId")

const token = getAccessToken()

if (paymentId && token) {
  try {
    const payment = await getMercadoPagoPaymentStatus(paymentId)
    const targetOrder = payment.orderId || orderId
    if (targetOrder && (payment.status === "approved" || status === "approved" || !status)) {
      await approveOrderAndTickets(targetOrder, paymentId)
    }
  } catch (error) {
    console.error("Error consultando API de Mercado Pago en confirmación:", error)
  }
}

if (orderId) {
  try {
    await approveOrderAndTickets(orderId, paymentId || undefined)
  } catch (error) {
    console.error("Error aprobando orden al retornar de MP:", error)
  }
}
---

<Layout title="Compra confirmada | Valdivia Automotores">
  <!-- Sin compra -->
  <div id="no-order" class="container-app hidden py-20 text-center">
    <p class="font-display text-xl font-700 text-navy">No encontramos una compra reciente.</p>
    <a href="/participar" class="btn-primary mt-6">Participar del sorteo</a>
  </div>

  <div id="order" class="container-app hidden py-14">
    <div class="mx-auto max-w-2xl text-center">
      <span class="mx-auto flex h-20 w-20 animate-pulse-ring items-center justify-center rounded-full bg-brand/10 text-brand">
        <CheckCircle2 class="h-11 w-11" />
      </span>
      <span class="mt-6 block text-sm font-semibold uppercase tracking-[0.16em] text-brand">Paso 3 de 3</span>
      <h1 class="mt-2 font-display text-3xl font-800 text-navy sm:text-4xl">¡Compra confirmada!</h1>
      <p class="mt-3 text-navy/70">
        Ya estás participando por el <strong>{raffle.prizeName} {raffle.prizeYear}</strong>. El sorteo se realiza el {drawDate}.
      </p>
    </div>

    <div class="mx-auto mt-10 max-w-2xl space-y-6">
      <!-- Ticket resumen -->
      <div class="card overflow-hidden">
        <div class="flex items-center justify-between bg-navy px-6 py-4 text-white">
          <div class="flex items-center gap-3">
            <Image src={logoValdivia} alt="Valdivia Automotores" width={36} height={36} class="h-9 w-9 rounded-lg bg-white/95 object-contain p-1" />
            <span class="font-display font-700">Comprobante de participación</span>
          </div>
          <span class="rounded-lg bg-brand px-3 py-1 text-xs font-800" id="order-id">#000000</span>
        </div>
        <div class="grid gap-4 p-6 sm:grid-cols-2">
          <div>
            <p class="text-xs font-semibold uppercase tracking-wide text-navy/50">Comprador</p>
            <p class="mt-1 font-700 text-navy" id="buyer-name">-</p>
          </div>
          <div>
            <p class="text-xs font-semibold uppercase tracking-wide text-navy/50">Email</p>
            <p class="mt-1 font-700 text-navy" id="buyer-email">-</p>
          </div>
          <div>
            <p class="text-xs font-semibold uppercase tracking-wide text-navy/50">Cantidad</p>
            <p class="mt-1 font-700 text-navy" id="buyer-qty">-</p>
          </div>
          <div>
            <p class="text-xs font-semibold uppercase tracking-wide text-navy/50">Total abonado</p>
            <p class="mt-1 font-800 text-brand" id="buyer-total">-</p>
          </div>
        </div>
      </div>

      <!-- Números asignados -->
      <div class="card p-6">
        <h2 class="flex items-center gap-2 font-display text-lg font-700 text-navy">
          <Ticket class="h-5 w-5 text-brand" />
          Tus números de la suerte
        </h2>
        <div id="numbers" class="mt-4 flex flex-wrap gap-2"></div>
      </div>

      <div class="flex items-center justify-center gap-2 rounded-xl bg-brand/5 p-4 text-sm text-navy/70">
        <Mail class="h-4 w-4 text-brand" />
        Te enviamos una copia del comprobante a tu email.
      </div>

      <div class="flex justify-center">
        <a href="/" class="btn-secondary">
          <Home class="h-5 w-5" />
          Volver al inicio
        </a>
      </div>
    </div>
  </div>
</Layout>

<script>
  import { readCart, clearCart, formatARS, generateTicketNumbers } from "@/lib/cart"

  function init() {
    const cart = readCart()

    const noOrder = document.getElementById("no-order")
    const order = document.getElementById("order")

    if (!cart || cart.tickets < 1) {
      noOrder?.classList.remove("hidden")
      return
    }
    order?.classList.remove("hidden")

    const set = (id: string, val: string) => {
      const el = document.getElementById(id)
      if (el) el.textContent = val
    }

    const cartExt = cart as typeof cart & { orderId?: string; ticketsList?: string[] }
    const orderId = cartExt?.orderId ? `#${cartExt.orderId}` : "#" + Math.floor(100000 + Math.random() * 900000)
    set("order-id", orderId)
    set("buyer-name", cart.buyer?.name || "Participante")
    set("buyer-email", cart.buyer?.email || "-")
    set("buyer-qty", `${cart.tickets} números`)
    set("buyer-total", formatARS(cart.amount))

    const numbersEl = document.getElementById("numbers")
    if (numbersEl) {
      const nums = cartExt?.ticketsList && cartExt.ticketsList.length > 0
        ? cartExt.ticketsList
        : generateTicketNumbers(cart.tickets)
      numbersEl.innerHTML = nums
        .map(
          (n) =>
            `<span class="rounded-lg border border-navy/10 bg-cloud px-3 py-1.5 font-display text-sm font-800 tracking-wider text-navy">#${n}</span>`,
        )
        .join("")
    }

    // Limpiar el carrito para que no se reutilice al refrescar
    clearCart()
  }

  init()
  document.addEventListener("astro:page-load", init)
</script>
