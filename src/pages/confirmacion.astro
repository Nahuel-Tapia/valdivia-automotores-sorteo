---
import Layout from "@/layouts/Layout.astro"
import { raffle } from "@/data/raffle"
import { CheckCircle2, Mail, Home, Ticket } from "lucide-astro"
import { Image } from "astro:assets"
import logoValdivia from "@/assets/logo-valdivia.png"
import { getMercadoPagoPaymentStatus, processMercadoPagoPaymentStatus, getAccessToken } from "@/lib/services/mercadopago"
import { approveOrderAndTickets, rejectOrderAndReleaseTickets } from "@/lib/services/tickets"

export const prerender = false

const drawDate = new Date(raffle.drawDate).toLocaleDateString("es-AR", {
  day: "2-digit",
  month: "long",
  year: "numeric",
})

// Auto-aprobación estricta en DB SOLO SI el pago fue aprobado por Mercado Pago
const paymentId = Astro.url.searchParams.get("payment_id") || Astro.url.searchParams.get("collection_id")
const status = Astro.url.searchParams.get("status") || Astro.url.searchParams.get("collection_status")
const orderId = Astro.url.searchParams.get("external_reference") || Astro.url.searchParams.get("orderId")

const token = getAccessToken()

if (paymentId && token) {
  try {
    const payment = await getMercadoPagoPaymentStatus(paymentId)
    const targetOrder = payment.orderId || orderId
    if (targetOrder && (payment.status === "approved" || status === "approved")) {
      await approveOrderAndTickets(targetOrder, paymentId)
    } else if (targetOrder && (payment.status === "rejected" || payment.status === "cancelled" || status === "rejected" || status === "failure")) {
      await rejectOrderAndReleaseTickets(targetOrder, paymentId)
      return Astro.redirect(`/pago-rechazado?orderId=${targetOrder}`)
    }
  } catch (error) {
    console.error("Error consultando API de Mercado Pago en confirmación:", error)
  }
} else if (orderId && status === "approved") {
  try {
    await approveOrderAndTickets(orderId, paymentId || undefined)
  } catch (error) {
    console.error("Error aprobando orden al retornar de MP:", error)
  }
} else if (orderId && (status === "rejected" || status === "failure")) {
  try {
    await rejectOrderAndReleaseTickets(orderId, paymentId || undefined)
    return Astro.redirect(`/pago-rechazado?orderId=${orderId}`)
  } catch (error) {
    console.error("Error rechazando orden al retornar de MP:", error)
  }
}
---

<Layout title="Compra confirmada | Valdivia Automotores">
  <!-- Sin compra -->
  <div id="no-order" class="container-app hidden py-20 text-center">
    <p class="font-display text-xl font-700 text-navy">No encontramos una compra reciente.</p>
    <a href="/participar" class="btn-primary mt-6">Participar del sorteo</a>
  </div>

  <section id="confirmation-content" class="container-app py-12 sm:py-16">
    <div class="mx-auto max-w-3xl">
      <!-- Banner Aprobado -->
      <div class="card bg-emerald-500/10 border-emerald-500/20 p-6 text-center sm:p-8">
        <span class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-emerald-500 text-white shadow-glow">
          <CheckCircle2 class="h-9 w-9" />
        </span>
        <h1 class="mt-4 font-display text-2xl font-800 text-navy sm:text-3xl">¡Pago Aprobado y Boletos Asignados!</h1>
        <p class="mt-2 text-sm text-navy/70">
          Tu compra fue procesada correctamente por Mercado Pago y tus números ya fueron registrados oficialmente.
        </p>
      </div>

      <!-- Detalle de la Orden -->
      <div class="mt-8 card p-6 sm:p-8">
        <div class="flex flex-wrap items-center justify-between gap-4 border-b border-navy/10 pb-6">
          <div>
            <span class="text-xs font-bold uppercase tracking-widest text-brand">Comprobante Digital</span>
            <h2 id="order-id-title" class="font-display text-xl font-800 text-navy sm:text-2xl">Cargando orden...</h2>
          </div>
          <span class="rounded-full bg-emerald-100 px-3 py-1 text-xs font-800 text-emerald-700">APROBADO</span>
        </div>

        <!-- Boletos de la Suerte -->
        <div class="mt-6">
          <h3 class="flex items-center gap-2 text-sm font-700 text-navy uppercase tracking-wider">
            <Ticket class="h-4 w-4 text-brand" />
            Tus Números de la Suerte:
          </h3>
          <div id="tickets-grid" class="mt-3 flex flex-wrap gap-2">
            <span class="text-xs text-navy/40">Obteniendo boletos asignados...</span>
          </div>
        </div>

        <div class="mt-8 grid gap-4 rounded-2xl bg-cloud/50 p-4 text-sm sm:grid-cols-2">
          <div>
            <span class="block text-xs text-navy/60">Comprador</span>
            <span id="buyer-name" class="font-700 text-navy">-</span>
          </div>
          <div>
            <span class="block text-xs text-navy/60">Email</span>
            <span id="buyer-email" class="font-700 text-navy">-</span>
          </div>
          <div>
            <span class="block text-xs text-navy/60">Fecha del Sorteo</span>
            <span class="font-700 text-navy">{drawDate}</span>
          </div>
          <div>
            <span class="block text-xs text-navy/60">Canal de Transmisión</span>
            <span class="font-700 text-navy">{raffle.drawChannel}</span>
          </div>
        </div>

        <div class="mt-6 flex items-start gap-3 rounded-xl border border-navy/10 bg-white p-4 text-xs text-navy/70">
          <Mail class="h-5 w-5 shrink-0 text-brand mt-0.5" />
          <p>
            Enviamos el comprobante digital a tu correo electrónico. Guardá este resumen para consultar tus boletos cuando desees.
          </p>
        </div>

        <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
          <a href="/mis-boletos" class="btn-primary">Ver mis boletos guardados</a>
          <a href="/" class="btn-secondary">
            <Home class="h-5 w-5" />
            Volver al Inicio
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  import { readCart, clearCart, formatARS } from "@/lib/cart"

  function init() {
    const cart = readCart()
    const urlParams = new URLSearchParams(window.location.search)
    const urlOrderId = urlParams.get("external_reference") || urlParams.get("orderId")

    const orderId = urlOrderId || cart?.orderId

    if (!orderId) {
      document.getElementById("confirmation-content")?.classList.add("hidden")
      document.getElementById("no-order")?.classList.remove("hidden")
      return
    }

    const titleEl = document.getElementById("order-id-title")
    const buyerNameEl = document.getElementById("buyer-name")
    const buyerEmailEl = document.getElementById("buyer-email")
    const gridEl = document.getElementById("tickets-grid")

    if (titleEl) titleEl.textContent = `Orden #${orderId}`

    if (cart?.buyer) {
      if (buyerNameEl) buyerNameEl.textContent = cart.buyer.name
      if (buyerEmailEl) buyerEmailEl.textContent = cart.buyer.email
    }

    if (cart?.ticketsList && Array.isArray(cart.ticketsList) && gridEl) {
      gridEl.innerHTML = cart.ticketsList
        .map(
          (num: string) => `
        <span class="rounded-xl bg-navy text-gold px-3 py-1.5 font-display text-sm font-800 shadow-sm border border-navy/20">
          #${num}
        </span>
      `
        )
        .join("")
    }

    clearCart()
  }

  init()
</script>
