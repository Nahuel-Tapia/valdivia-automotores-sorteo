---
import Layout from "@/layouts/Layout.astro"
import { Lock, ArrowRight, CreditCard, Wallet, ShieldCheck } from "lucide-astro"
---

<Layout title="Checkout | Valdivia Automotores">
  <section class="bg-navy py-10 text-white">
    <div class="container-app">
      <span class="text-sm font-semibold uppercase tracking-[0.16em] text-brand-light">Paso 2 de 3</span>
      <h1 class="mt-2 font-display text-3xl font-800 sm:text-4xl">Finalizá tu compra</h1>
      <p class="mt-2 flex items-center gap-2 text-white/75">
        <Lock class="h-4 w-4 text-brand-light" />
        Pago protegido y encriptado
      </p>
    </div>
  </section>

  <!-- Estado sin carrito -->
  <div id="empty-state" class="container-app hidden py-20 text-center">
    <p class="font-display text-xl font-700 text-navy">No seleccionaste números todavía.</p>
    <a href="/participar" class="btn-primary mt-6">Elegir mis números</a>
  </div>

  <form id="checkout-form" class="container-app grid gap-8 py-12 lg:grid-cols-[1fr_360px]" novalidate>
    <div class="space-y-8">
      <!-- Datos del comprador -->
      <fieldset class="card p-6">
        <legend class="px-2 font-display text-lg font-700 text-navy">Tus datos personales</legend>
        <div class="mt-4 grid gap-4 sm:grid-cols-2">
          <!-- Nombre Completo (Solo letras, máx 80) -->
          <label class="block">
            <span class="text-sm font-600 text-navy/70">Nombre completo</span>
            <input
              required
              id="input-name"
              name="name"
              type="text"
              maxlength="80"
              class="input"
              placeholder="Ej: Juan Carlos Pérez"
            />
            <span id="err-name" class="mt-1 hidden text-xs font-600 text-red-600">Solo se permiten letras (máximo 80 caracteres)</span>
          </label>

          <!-- DNI (Exactamente 8 dígitos) -->
          <label class="block">
            <span class="text-sm font-600 text-navy/70">DNI (8 números)</span>
            <input
              required
              id="input-dni"
              name="dni"
              type="text"
              inputmode="numeric"
              maxlength="8"
              minlength="8"
              class="input"
              placeholder="Ej: 40123456"
            />
            <span id="err-dni" class="mt-1 hidden text-xs font-600 text-red-600">El DNI debe tener exactamente 8 números</span>
          </label>

          <!-- Email (Formato correo con @ y .com) -->
          <label class="block">
            <span class="text-sm font-600 text-navy/70">Email</span>
            <input
              required
              id="input-email"
              name="email"
              type="email"
              class="input"
              placeholder="Ej: juan.perez@gmail.com"
            />
            <span id="err-email" class="mt-1 hidden text-xs font-600 text-red-600">Formato inválido (debe contener @ y .com)</span>
          </label>

          <!-- Teléfono (Entre 9 y 11 números) -->
          <label class="block">
            <span class="text-sm font-600 text-navy/70">Teléfono (9 a 11 números)</span>
            <input
              required
              id="input-phone"
              name="phone"
              type="tel"
              inputmode="numeric"
              maxlength="11"
              minlength="9"
              class="input"
              placeholder="Ej: 1155554444"
            />
            <span id="err-phone" class="mt-1 hidden text-xs font-600 text-red-600">Debe contener entre 9 y 11 números</span>
          </label>
        </div>
      </fieldset>

      <!-- Método de pago (100% Pasarela Oficial Mercado Pago) -->
      <fieldset class="card p-6">
        <legend class="px-2 font-display text-lg font-700 text-navy">Pasarela de pago oficial</legend>
        <input type="hidden" name="pay" value="mercadopago" />
        <div class="mt-4 flex items-center gap-4 rounded-xl border-2 border-brand bg-brand/5 p-4">
          <Wallet class="h-6 w-6 text-brand" />
          <span class="flex-1">
            <span class="block font-700 text-navy">Mercado Pago</span>
            <span class="block text-sm text-navy/60">Dinero en cuenta, tarjetas de crédito/débito y Rapipago/PagoFácil</span>
          </span>
          <span class="rounded-md bg-[#009ee3] px-2.5 py-1 text-xs font-800 text-white">MP</span>
        </div>

        <p class="mt-4 flex items-center gap-2 text-xs text-navy/50">
          <ShieldCheck class="h-4 w-4 text-brand" />
          Procesamiento cifrado con certificado de seguridad SSL y protección al comprador.
        </p>
      </fieldset>
    </div>

    <!-- Resumen -->
    <aside class="lg:sticky lg:top-24 lg:self-start">
      <div class="card p-6">
        <h3 class="font-display text-lg font-700 text-navy">Resumen de tu compra</h3>
        <dl class="mt-4 space-y-3 text-sm">
          <div class="flex items-center justify-between">
            <dt class="text-navy/60">Números elegidos</dt>
            <dd class="font-700 text-navy" id="c-qty">-</dd>
          </div>
          <div class="flex items-center justify-between">
            <dt class="text-navy/60">Subtotal</dt>
            <dd class="font-700 text-navy" id="c-sub">-</dd>
          </div>
          <div class="h-px bg-navy/10"></div>
          <div class="flex items-center justify-between">
            <dt class="font-display text-base font-700 text-navy">Total a abonar</dt>
            <dd class="font-display text-2xl font-800 text-brand" id="c-total">-</dd>
          </div>
        </dl>
        <button type="submit" id="pay-btn" class="btn-primary mt-6 w-full">
          <span id="pay-label">Pagar con Mercado Pago</span>
          <ArrowRight class="h-5 w-5" />
        </button>
        <p class="mt-3 text-center text-xs text-navy/50">Al continuar aceptás las bases y condiciones legales del sorteo.</p>
      </div>
    </aside>
  </form>
</Layout>

<style>
  .input {
    @apply mt-1 h-11 w-full rounded-xl border border-navy/15 px-3 text-navy transition focus:border-brand focus:outline-none focus:ring-2 focus:ring-brand/20;
  }
</style>

<script>
  import { readCart, writeCart, formatARS } from "@/lib/cart"

  function init() {
    const cart = readCart()
    const form = document.getElementById("checkout-form") as HTMLFormElement | null
    const empty = document.getElementById("empty-state")
    const transferInfo = document.getElementById("transfer-info")

    if (!cart || cart.tickets < 1) {
      form?.classList.add("hidden")
      empty?.classList.remove("hidden")
      return
    }

    const qty = document.getElementById("c-qty")
    const sub = document.getElementById("c-sub")
    const total = document.getElementById("c-total")
    if (qty) qty.textContent = String(cart.tickets)
    if (sub) sub.textContent = formatARS(cart.amount)
    if (total) total.textContent = formatARS(cart.amount)

    // Elementos de Entrada
    const inputName = document.getElementById("input-name") as HTMLInputElement
    const inputDni = document.getElementById("input-dni") as HTMLInputElement
    const inputEmail = document.getElementById("input-email") as HTMLInputElement
    const inputPhone = document.getElementById("input-phone") as HTMLInputElement

    const errName = document.getElementById("err-name")
    const errDni = document.getElementById("err-dni")
    const errEmail = document.getElementById("err-email")
    const errPhone = document.getElementById("err-phone")

    // Sanitización en tiempo real
    inputName?.addEventListener("input", () => {
      inputName.value = inputName.value.replace(/[^a-zA-ZáéíóúÁÉÍÓÚñÑ\s]/g, "").slice(0, 80)
      if (errName) errName.classList.add("hidden")
    })

    inputDni?.addEventListener("input", () => {
      inputDni.value = inputDni.value.replace(/\D/g, "").slice(0, 8)
      if (errDni) errDni.classList.add("hidden")
    })

    inputEmail?.addEventListener("input", () => {
      if (errEmail) errEmail.classList.add("hidden")
    })

    inputPhone?.addEventListener("input", () => {
      inputPhone.value = inputPhone.value.replace(/\D/g, "").slice(0, 11)
      if (errPhone) errPhone.classList.add("hidden")
    })

    form?.addEventListener("submit", async (e) => {
      e.preventDefault()
      let isValid = true
      const allInputs = [inputName, inputDni, inputEmail, inputPhone]
      const allErrors = [errName, errDni, errEmail, errPhone]

      // Limpiar estilos de error previos
      allInputs.forEach(i => i?.classList.remove("!border-red-500", "!ring-red-200"))
      allErrors.forEach(e => e?.classList.add("hidden"))

      // 1. Validar Nombre (solo letras, máx 80)
      const nameVal = inputName.value.trim()
      const nameRegex = /^[a-zA-ZáéíóúÁÉÍÓÚñÑ\s]{2,80}$/
      if (!nameRegex.test(nameVal)) {
        errName?.classList.remove("hidden")
        inputName?.classList.add("!border-red-500", "!ring-red-200")
        isValid = false
      }

      // 2. Validar DNI (exactamente 8 números)
      const dniVal = inputDni.value.replace(/\D/g, "")
      if (dniVal.length !== 8) {
        errDni?.classList.remove("hidden")
        inputDni?.classList.add("!border-red-500", "!ring-red-200")
        isValid = false
      }

      // 3. Validar Email (debe incluir @ y dominio válido)
      const emailVal = inputEmail.value.trim()
      const emailRegex = /^[^\s@]+@[^\s@]+\.[a-zA-Z]{2,}(\.[a-zA-Z]{2,})?$/
      if (!emailRegex.test(emailVal)) {
        errEmail?.classList.remove("hidden")
        inputEmail?.classList.add("!border-red-500", "!ring-red-200")
        isValid = false
      }

      // 4. Validar Teléfono (entre 9 y 11 números)
      const phoneVal = inputPhone.value.replace(/\D/g, "")
      if (phoneVal.length < 9 || phoneVal.length > 11) {
        errPhone?.classList.remove("hidden")
        inputPhone?.classList.add("!border-red-500", "!ring-red-200")
        isValid = false
      }

      if (!isValid) {
        // Scroll al primer campo con error
        const firstError = document.querySelector(".\\!border-red-500") as HTMLElement
        firstError?.scrollIntoView({ behavior: "smooth", block: "center" })
        firstError?.focus()
        return
      }

      const btn = document.getElementById("pay-btn") as HTMLButtonElement | null
      const label = document.getElementById("pay-label")
      const fd = new FormData(form)

      if (btn) btn.disabled = true
      if (label) label.textContent = "Procesando orden de reserva..."
      if (btn) btn.classList.add("opacity-70")

      const buyerData = {
        name: nameVal,
        email: emailVal,
        method: String(fd.get("pay") ?? ""),
        dni: dniVal,
        phone: phoneVal,
      }

      try {
        const checkoutRes = await fetch("/api/checkout", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            tickets: cart.tickets,
            selectedNumbers: (cart as any).selectedNumbers,
            sessionId: localStorage.getItem("valdivia_session_id") || undefined,
            buyer: buyerData,
            paymentMethod: buyerData.method,
          }),
        })

        const checkoutData = await checkoutRes.json()
        if (!checkoutRes.ok || !checkoutData.success) {
          alert(checkoutData.error || "Error al procesar la reserva.")
          if (btn) btn.disabled = false
          if (btn) btn.classList.remove("opacity-70")
          if (label) label.textContent = "Reintentar"
          return
        }

        writeCart({
          ...cart,
          buyer: buyerData,
          // @ts-expect-error opcional para la vista
          orderId: checkoutData.orderId,
          ticketsList: checkoutData.tickets,
        })

        if (checkoutData.initPoint) {
          if (label) label.textContent = checkoutData.isDemo ? "Redirigiendo a Mercado Pago Demo..." : "Redirigiendo a Mercado Pago Oficial..."
          window.location.href = checkoutData.initPoint
          return
        }

        window.location.href = `/confirmacion?orderId=${checkoutData.orderId}`
      } catch (err) {
        console.error("Error en checkout:", err)
        alert("Ocurrió un error al comunicarse con el servidor.")
        if (btn) btn.disabled = false
        if (btn) btn.classList.remove("opacity-70")
        if (label) label.textContent = "Reintentar"
      }
    })
  }

  init()
  document.addEventListener("astro:page-load", init)
</script>
