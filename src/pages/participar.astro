---
import Layout from "@/layouts/Layout.astro"
import { raffle, formatCurrency } from "@/data/raffle"
import { getDBTickets } from "@/lib/services/tickets"
import { ArrowRight, Search, Shuffle, Clock } from "lucide-astro"

// Cargar primeros 60 tickets desde la DB para renderizado inicial
const initialTickets = await getDBTickets("", "all", 60)
---

<Layout title="Reserva de Números Estilo Cine | Valdivia Automotores">
  <section class="bg-navy py-10 text-white">
    <div class="container-app">
      <span class="text-sm font-semibold uppercase tracking-[0.16em] text-brand-light">Paso 1 de 3</span>
      <h1 class="mt-2 font-display text-3xl font-800 sm:text-4xl">Reservá tus números en tiempo real</h1>
      <p class="mt-2 max-w-xl text-white/75">
        Elegí tus boletos en la grilla estilo las butacas de un cine. Los números que selecciones quedarán **congelados exclusivamente para vos** durante 10 minutos.
      </p>
    </div>
  </section>

  <!-- Banner de Reserva Activa con Temporizador Regresivo (Oculto por defecto) -->
  <div id="reservation-timer-bar" class="hidden bg-brand py-3 text-white shadow-md sticky top-16 z-40">
    <div class="container-app flex flex-wrap items-center justify-between gap-3 text-sm font-700">
      <div class="flex items-center gap-2">
        <Clock class="h-5 w-5 animate-pulse text-gold" />
        <span>Reserva activa: <strong id="selected-count-badge">0</strong> boletos congelados</span>
      </div>
      <div class="flex items-center gap-2 rounded-lg bg-navy px-3 py-1 text-gold font-display text-base">
        <span>Expira en:</span>
        <span id="countdown-timer">09:59</span>
      </div>
    </div>
  </div>

  <div class="container-app grid gap-8 py-10 lg:grid-cols-[1fr_360px]">
    <!-- Contenido Izquierdo: Mapa de Boletos -->
    <div class="space-y-6">
      <div class="card p-6">
        <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
          <div>
            <h2 class="font-display text-lg font-700 text-navy">Selección de Butacas / Boletos</h2>
            <p class="text-xs text-navy/60">Tocá cualquier casilla verde para congelarla inmediatamente</p>
          </div>
          <button type="button" id="btn-random" class="btn-secondary text-sm py-2 px-3">
            <Shuffle class="h-4 w-4 text-brand" />
            Selección Aleatoria
          </button>
        </div>

        <div class="mt-4 flex items-center gap-3">
          <div class="relative flex-1">
            <Search class="absolute left-3.5 top-1/2 h-4 w-4 -translate-y-1/2 text-navy/40" />
            <input
              type="text"
              id="search-ticket"
              placeholder="Buscar boleto específico (ej. 00042)..."
              maxLength={5}
              class="h-11 w-full rounded-xl border border-navy/15 pl-10 pr-4 text-sm font-display text-navy focus:border-brand focus:outline-none"
            />
          </div>
        </div>

        <!-- Leyenda de Estados Cine -->
        <div class="mt-5 flex flex-wrap items-center gap-6 text-xs font-700 text-navy/70 border-t border-navy/10 pt-4">
          <span class="flex items-center gap-2"><span class="h-4 w-4 rounded-md bg-emerald-100 border-2 border-emerald-500 shadow-sm"></span> 🟢 Disponible</span>
          <span class="flex items-center gap-2"><span class="h-4 w-4 rounded-md bg-amber-400 border-2 border-amber-600 shadow-sm"></span> 🟡 Tu Reserva (Congelado)</span>
          <span class="flex items-center gap-2"><span class="h-4 w-4 rounded-md bg-slate-200 border border-slate-400 opacity-60"></span> 🔴 Ocupado / Vendido</span>
        </div>
      </div>

      <!-- Grilla Interactiva estilo Cine -->
      <div class="card p-6">
        <div class="flex items-center justify-between mb-4">
          <h3 class="font-display text-base font-700 text-navy">Mapa de números disponibles</h3>
          <span class="text-xs font-600 text-brand flex items-center gap-1">
            <span class="h-2 w-2 rounded-full bg-emerald-500 animate-ping"></span> Sincronizado en vivo
          </span>
        </div>

        <div id="grid-container" class="grid grid-cols-4 sm:grid-cols-6 md:grid-cols-8 gap-2.5">
          {
            initialTickets.map((t) => (
              <button
                type="button"
                data-number={t.number}
                class="seat-btn group relative rounded-xl border-2 py-3 text-center font-display text-xs font-800 transition-all duration-200 shadow-sm border-emerald-500/40 bg-emerald-50 text-emerald-950 hover:bg-emerald-100 hover:scale-105"
              >
                <span class="seat-num">{t.number}</span>
              </button>
            ))
          }
        </div>
      </div>
    </div>

    <!-- Resumen sticky -->
    <aside class="lg:sticky lg:top-24 lg:self-start">
      <div class="card p-6">
        <h3 class="font-display text-lg font-700 text-navy">Tu compra</h3>
        <dl class="mt-4 space-y-3 text-sm">
          <div class="flex items-center justify-between">
            <dt class="text-navy/60">Cantidad de números</dt>
            <dd class="font-700 text-navy" id="sum-qty">0</dd>
          </div>
          <div class="flex items-center justify-between">
            <dt class="text-navy/60">Precio unitario</dt>
            <dd class="font-700 text-navy" id="sum-unit">{formatCurrency(raffle.ticketBasePrice)}</dd>
          </div>
          <div class="h-px bg-navy/10"></div>
          <div class="flex items-center justify-between">
            <dt class="font-display text-base font-700 text-navy">Total</dt>
            <dd class="font-display text-2xl font-800 text-brand" id="sum-total">{formatCurrency(0)}</dd>
          </div>
        </dl>
        <button id="btn-submit-checkout" class="btn-primary mt-6 w-full">
          Continuar al pago
          <ArrowRight class="h-5 w-5" />
        </button>
        <p class="mt-3 text-center text-xs text-navy/50">Pago seguro con Mercado Pago</p>
      </div>
    </aside>
  </div>
</Layout>

<script>
  import { writeCart, formatARS } from "@/lib/cart"
  import { raffle } from "@/data/raffle"

  function initCinemaGrid() {
    let sessionId = localStorage.getItem("valdivia_session_id")
    if (!sessionId) {
      sessionId = "sess_" + Date.now() + "_" + Math.random().toString(36).substring(2, 9)
      localStorage.setItem("valdivia_session_id", sessionId)
    }

    const base = raffle.ticketBasePrice
    const seatBtns = Array.from(document.querySelectorAll<HTMLButtonElement>(".seat-btn"))
    const timerBar = document.getElementById("reservation-timer-bar")
    const countdownEl = document.getElementById("countdown-timer")
    const badgeCount = document.getElementById("selected-count-badge")
    const sumQty = document.getElementById("sum-qty")
    const sumUnit = document.getElementById("sum-unit")
    const sumTotal = document.getElementById("sum-total")

    let selectedNumbers: string[] = []
    let earliestExpiry: number | null = null
    let timerInterval: any = null

    const renderSummary = () => {
      const count = selectedNumbers.length
      const totalAmount = count * base
      if (sumQty) sumQty.textContent = String(count)
      if (sumUnit) sumUnit.textContent = formatARS(base)
      if (sumTotal) sumTotal.textContent = formatARS(totalAmount)

      if (selectedNumbers.length > 0) {
        timerBar?.classList.remove("hidden")
        if (badgeCount) badgeCount.textContent = String(selectedNumbers.length)
      } else {
        timerBar?.classList.add("hidden")
      }
    }

    const applyStatuses = (statuses: Record<string, { status: "mine" | "occupied" | "paid"; reservedUntil?: number }>) => {
      selectedNumbers = []
      earliestExpiry = null

      seatBtns.forEach((btn) => {
        const num = btn.dataset.number
        if (!num) return

        const info = statuses[num]

        if (!info) {
          btn.disabled = false
          btn.className = "seat-btn group relative rounded-xl border-2 py-3 text-center font-display text-xs font-800 transition-all duration-200 shadow-sm border-emerald-500/40 bg-emerald-50 text-emerald-950 hover:bg-emerald-100 hover:scale-105 cursor-pointer"
        } else if (info.status === "mine") {
          selectedNumbers.push(num)
          if (info.reservedUntil && (!earliestExpiry || info.reservedUntil < earliestExpiry)) {
            earliestExpiry = info.reservedUntil
          }
          btn.disabled = false
          btn.className = "seat-btn group relative rounded-xl border-2 py-3 text-center font-display text-xs font-800 transition-all duration-200 shadow-sm border-amber-600 bg-amber-400 text-navy hover:bg-amber-300 hover:scale-105 cursor-pointer"
        } else {
          btn.disabled = true
          btn.className = "seat-btn group relative rounded-xl border py-3 text-center font-display text-xs font-700 transition-all duration-200 border-slate-300 bg-slate-200 text-slate-400 opacity-60 cursor-not-allowed"
        }
      })

      renderSummary()
      startCountdownTimer()
    }

    seatBtns.forEach((btn) => {
      btn.addEventListener("click", async () => {
        const num = btn.dataset.number
        if (!num) return

        btn.style.opacity = "0.5"
        try {
          const res = await fetch("/api/tickets/seat-lock", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ number: num, sessionId }),
          })

          const data = await res.json()
          if (!res.ok || !data.success) {
            alert(data.error || "No se pudo modificar la reserva.")
          }
          fetchLiveStatus()
        } catch {
          alert("Error de red al intentar reservar la butaca.")
        } finally {
          btn.style.opacity = "1"
        }
      })
    })

    const fetchLiveStatus = async () => {
      try {
        const res = await fetch(`/api/tickets/live-status?sessionId=${sessionId}`)
        const data = await res.json()
        if (data.success) {
          applyStatuses(data.statuses || {})
        }
      } catch (err) {
        console.error("Error sincronizando butacas:", err)
      }
    }

    const startCountdownTimer = () => {
      if (timerInterval) clearInterval(timerInterval)

      if (!earliestExpiry || selectedNumbers.length === 0) return

      timerInterval = setInterval(() => {
        const diff = Math.max(0, Math.floor((earliestExpiry! - Date.now()) / 1000))
        const mins = String(Math.floor(diff / 60)).padStart(2, "0")
        const secs = String(diff % 60).padStart(2, "0")

        if (countdownEl) countdownEl.textContent = `${mins}:${secs}`

        if (diff <= 0) {
          clearInterval(timerInterval)
          fetchLiveStatus()
        }
      }, 1000)
    }

    // Buscador interactivo
    const searchInput = document.getElementById("search-ticket") as HTMLInputElement | null
    searchInput?.addEventListener("input", (e) => {
      const val = (e.target as HTMLInputElement).value.trim()
      seatBtns.forEach((btn) => {
        const num = btn.dataset.number ?? ""
        if (!val || num.includes(val)) {
          btn.classList.remove("hidden")
        } else {
          btn.classList.add("hidden")
        }
      })
    })

    // Botón Continuar al Pago
    document.getElementById("btn-submit-checkout")?.addEventListener("click", () => {
      if (selectedNumbers.length === 0) {
        alert("Por favor selecciona al menos 1 boleto verde en la grilla para continuar.")
        return
      }

      const ticketsCount = selectedNumbers.length
      const totalAmount = ticketsCount * base

      writeCart({
        tickets: ticketsCount,
        amount: totalAmount,
        packageId: null,
        // @ts-expect-error opcional para pasar la lista de asientos seleccionados
        selectedNumbers: selectedNumbers,
      })

      window.location.href = "/checkout"
    })

    fetchLiveStatus()
    setInterval(fetchLiveStatus, 3000)
  }

  initCinemaGrid()
  document.addEventListener("astro:page-load", initCinemaGrid)
</script>
