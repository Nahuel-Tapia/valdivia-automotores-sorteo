---
import Layout from "@/layouts/Layout.astro"
import { raffle, formatCurrency } from "@/data/raffle"
import { Check, Ticket, Minus, Plus, ArrowRight } from "lucide-astro"
---

<Layout title="Participar | Valdivia Automotores">
  <section class="bg-navy py-10 text-white">
    <div class="container-app">
      <span class="text-sm font-semibold uppercase tracking-[0.16em] text-brand-light">Paso 1 de 3</span>
      <h1 class="mt-2 font-display text-3xl font-800 sm:text-4xl">Elegí tus números</h1>
      <p class="mt-2 max-w-xl text-white/75">
        Más números comprás, más chances de ganar el {raffle.prizeName}. Elegí un paquete o armá tu cantidad.
      </p>
    </div>
  </section>

  <div class="container-app grid gap-8 py-12 lg:grid-cols-[1fr_360px]">
    <!-- Paquetes -->
    <div>
      <h2 class="font-display text-xl font-700 text-navy">Paquetes destacados</h2>
      <div class="mt-5 grid gap-4 sm:grid-cols-2">
        {
          raffle.packages.map((pack) => (
            <button
              type="button"
              class="pack-option group relative rounded-2xl border-2 border-navy/10 bg-white p-5 text-left transition hover:border-brand"
              data-pack={pack.id}
              data-tickets={pack.tickets}
              data-price={pack.price}
            >
              {pack.popular && (
                <span class="absolute -top-3 right-4 rounded-full bg-gold px-3 py-1 text-xs font-800 uppercase tracking-wide text-navy">
                  Más elegido
                </span>
              )}
              <div class="flex items-center justify-between">
                <span class="flex items-center gap-2 font-display text-2xl font-800 text-navy">
                  <Ticket class="h-6 w-6 text-brand" />
                  {pack.tickets}
                </span>
                {pack.bonus && (
                  <span class="rounded-lg bg-brand/10 px-2 py-1 text-xs font-700 text-brand">{pack.bonus}</span>
                )}
              </div>
              <p class="mt-3 text-sm text-navy/60">números para el sorteo</p>
              <p class="mt-2 font-display text-xl font-800 text-navy">{formatCurrency(pack.price)}</p>
              <span class="check-badge mt-4 hidden items-center gap-1.5 text-sm font-700 text-brand">
                <Check class="h-4 w-4" /> Seleccionado
              </span>
            </button>
          ))
        }
      </div>

      <!-- Cantidad manual -->
      <div class="card mt-8 p-6">
        <h3 class="font-display text-lg font-700 text-navy">O elegí una cantidad</h3>
        <p class="text-sm text-navy/60">{formatCurrency(raffle.ticketBasePrice)} por número</p>
        <div class="mt-4 flex items-center gap-4">
          <button type="button" id="dec" class="flex h-11 w-11 items-center justify-center rounded-xl border border-navy/15 text-navy transition hover:bg-cloud" aria-label="Restar">
            <Minus class="h-5 w-5" />
          </button>
          <input
            id="qty"
            type="number"
            min="1"
            value="1"
            class="h-12 w-24 rounded-xl border border-navy/15 text-center font-display text-xl font-800 text-navy focus:border-brand focus:outline-none"
            aria-label="Cantidad de números"
          />
          <button type="button" id="inc" class="flex h-11 w-11 items-center justify-center rounded-xl border border-navy/15 text-navy transition hover:bg-cloud" aria-label="Sumar">
            <Plus class="h-5 w-5" />
          </button>
        </div>
      </div>
    </div>

    <!-- Resumen sticky -->
    <aside class="lg:sticky lg:top-24 lg:self-start">
      <div class="card p-6">
        <h3 class="font-display text-lg font-700 text-navy">Tu compra</h3>
        <dl class="mt-4 space-y-3 text-sm">
          <div class="flex items-center justify-between">
            <dt class="text-navy/60">Cantidad de números</dt>
            <dd class="font-700 text-navy" id="sum-qty">1</dd>
          </div>
          <div class="flex items-center justify-between">
            <dt class="text-navy/60">Precio unitario</dt>
            <dd class="font-700 text-navy" id="sum-unit">{formatCurrency(raffle.ticketBasePrice)}</dd>
          </div>
          <div class="h-px bg-navy/10"></div>
          <div class="flex items-center justify-between">
            <dt class="font-display text-base font-700 text-navy">Total</dt>
            <dd class="font-display text-2xl font-800 text-brand" id="sum-total">{formatCurrency(raffle.ticketBasePrice)}</dd>
          </div>
        </dl>
        <a href="/checkout" id="go-checkout" class="btn-primary mt-6 w-full">
          Continuar al pago
          <ArrowRight class="h-5 w-5" />
        </a>
        <p class="mt-3 text-center text-xs text-navy/50">Pago seguro con Mercado Pago</p>
      </div>
    </aside>
  </div>
</Layout>

<script>
  import { writeCart, formatARS } from "@/lib/cart"
  import { raffle } from "@/data/raffle"

  function init() {
    const base = raffle.ticketBasePrice
    const qtyInput = document.getElementById("qty") as HTMLInputElement | null
    const packButtons = Array.from(document.querySelectorAll<HTMLButtonElement>(".pack-option"))
    if (!qtyInput) return

    let tickets = 1
    let amount = base
    let packageId: string | null = null

    const sumQty = document.getElementById("sum-qty")
    const sumUnit = document.getElementById("sum-unit")
    const sumTotal = document.getElementById("sum-total")

    const render = () => {
      const unit = tickets > 0 ? Math.round(amount / tickets) : base
      if (sumQty) sumQty.textContent = String(tickets)
      if (sumUnit) sumUnit.textContent = formatARS(unit)
      if (sumTotal) sumTotal.textContent = formatARS(amount)
    }

    const clearPackSelection = () => {
      packButtons.forEach((b) => {
        b.classList.remove("border-brand", "ring-2", "ring-brand/30")
        b.querySelector(".check-badge")?.classList.add("hidden")
        b.querySelector(".check-badge")?.classList.remove("flex")
      })
    }

    const selectManual = () => {
      packageId = null
      clearPackSelection()
      tickets = Math.max(1, parseInt(qtyInput.value || "1", 10))
      qtyInput.value = String(tickets)
      amount = tickets * base
      render()
    }

    packButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        clearPackSelection()
        btn.classList.add("border-brand", "ring-2", "ring-brand/30")
        btn.querySelector(".check-badge")?.classList.remove("hidden")
        btn.querySelector(".check-badge")?.classList.add("flex")
        tickets = Number(btn.dataset.tickets)
        amount = Number(btn.dataset.price)
        packageId = btn.dataset.pack ?? null
        qtyInput.value = String(tickets)
        render()
      })
    })

    document.getElementById("inc")?.addEventListener("click", () => {
      qtyInput.value = String(Math.max(1, parseInt(qtyInput.value || "1", 10) + 1))
      selectManual()
    })
    document.getElementById("dec")?.addEventListener("click", () => {
      qtyInput.value = String(Math.max(1, parseInt(qtyInput.value || "1", 10) - 1))
      selectManual()
    })
    qtyInput.addEventListener("input", selectManual)

    document.getElementById("go-checkout")?.addEventListener("click", () => {
      writeCart({ tickets, amount, packageId })
    })

    render()
  }

  init()
  document.addEventListener("astro:page-load", init)
</script>
