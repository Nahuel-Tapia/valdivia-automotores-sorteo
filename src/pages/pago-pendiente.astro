---
import Layout from "@/layouts/Layout.astro"
import { Clock, Home, Ticket } from "lucide-astro"
import { getMercadoPagoPaymentStatus } from "@/lib/services/mercadopago"
import { processMercadoPagoPaymentStatus } from "@/lib/services/payment-processing"

export const prerender = false

const paymentId = Astro.url.searchParams.get("payment_id")
let processed: "approved" | "rejected" | "ignored" = "ignored"

if (paymentId && process.env.MERCADOPAGO_ACCESS_TOKEN) {
  try {
    const payment = await getMercadoPagoPaymentStatus(paymentId)
    processed = await processMercadoPagoPaymentStatus(payment)
  } catch (error) {
    console.error("Error sincronizando retorno pendiente de Mercado Pago:", error)
  }
}

if (processed === "approved") {
  return Astro.redirect("/confirmacion")
}

if (processed === "rejected") {
  return Astro.redirect("/pago-rechazado")
}
---

<Layout title="Pago pendiente | Valdivia Automotores">
  <section class="container-app py-16">
    <div class="mx-auto max-w-2xl text-center">
      <span class="mx-auto flex h-20 w-20 items-center justify-center rounded-full bg-amber-50 text-amber-600">
        <Clock class="h-11 w-11" />
      </span>
      <span class="mt-6 block text-sm font-semibold uppercase tracking-[0.16em] text-amber-600">Pago pendiente</span>
      <h1 class="mt-2 font-display text-3xl font-800 text-navy sm:text-4xl">Estamos esperando la confirmacion</h1>
      <p class="mt-3 text-navy/70">
        Mercado Pago todavia no informo un resultado final. Te vamos a avisar por email cuando se confirme.
      </p>
      <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
        <a href="/participar" class="btn-primary">
          <Ticket class="h-5 w-5" />
          Ver boletos
        </a>
        <a href="/" class="btn-secondary">
          <Home class="h-5 w-5" />
          Volver al inicio
        </a>
      </div>
    </div>
  </section>
</Layout>
